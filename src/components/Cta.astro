---
import { Image } from 'astro:assets';
import wall from '../assets/cta/wall.png';
import glow from '../assets/cta/glow.svg?url';
import dot from '../assets/cta/dot.svg?url';
import avatar398 from '../assets/cta/avatar-398.png';
import avatar424 from '../assets/cta/avatar-424.png';
import avatar413 from '../assets/cta/avatar-413.png';
import gmail from '../assets/icons/gmail-fill.png';
import calendar from '../assets/icons/calendar.png';
import linkedin from '../assets/icons/linkedin.svg?url';

// Positions are taken from the 1440px Figma frame.
const highlights = [
  { label: 'Emailed 12× this year', left: 261, top: 286, line: 72, tagX: -3, avatar: avatar398, icon: gmail, iconH: 6.25 },
  { label: 'Ex-colleague at Stripe', left: 501, top: 102, line: 64, tagX: -5, avatar: avatar424, svg: linkedin },
  { label: 'Met at YC Demo Day', left: 981, top: 194, line: 68, tagX: -1, avatar: avatar413, icon: calendar, iconH: 8.33 },
];
---

<section class="cta" aria-labelledby="cta-title">
  <div class="frame" data-fit="1440">
    <div class="wall" aria-hidden="true">
      <Image src={wall} alt="" widths={[1140, 2280]} sizes="1140px" loading="lazy" />
    </div>

    {
      highlights.map((h, i) => (
        <div class="highlight" style={`left:${h.left}px;top:${h.top}px;--line:${h.line}px;--delay:${i * 0.8}s`} aria-hidden="true">
          <img class="glow m-hide" src={glow} alt="" />
          <span class="line m-hide" />
          <span class="avatar m-hide">
            <Image src={h.avatar} alt="" width={50} height={50} densities={[1, 2]} loading="lazy" />
          </span>
          <img class="dot m-hide" src={dot} alt="" width="7" height="7" />
          <span class="tag m-hide" style={`left:${h.tagX}px`}>
            <span class="tag-icon">
              {h.svg ? (
                <img src={h.svg} alt="" width="8.333" height="8.333" />
              ) : (
                <Image src={h.icon!} alt="" width={24} style={`width:8.35px;height:${h.iconH}px`} />
              )}
            </span>
            <span class="tag-text">
              <span data-type={h.label}>{h.label}</span>
              <span class="tag-caret" />
            </span>
          </span>
        </div>
      ))
    }

    <div class="content">
      <h2 id="cta-title">Make your own luck</h2>
      <p>
        Join 500,000+ professionals already searching their whole network.<br class="br" /> Private by default, and never
        used to train AI models.
      </p>
      <div class="buttons">
        <button class="btn btn-primary" type="button">Search for free</button>
        <button class="btn btn-secondary" type="button">Continue with Google</button>
      </div>
    </div>
  </div>

  <script is:inline>
    // Lets the highlights rise in one by one only when motion is allowed.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.currentScript.parentElement.dataset.motion = 'pending';
  </script>
</section>

<script>
  import { createSequence, onFirstView, reducedMotion, pop, EASE_SETTLE, EASE_IN_OUT } from '../scripts/motion';

  // The three highlights rise in one after another when the section first comes into view:
  // the avatar lifts up, its line grows up to the tag, and the tag's label types itself out.
  const root = document.querySelector<HTMLElement>('.cta');

  if (root && root.dataset.motion === 'pending' && !reducedMotion()) {
    const seq = createSequence(root);
    seq.reset();
    root.dataset.motion = 'ready';

    const rise = (h: HTMLElement) => {
      const $ = (sel: string) => h.querySelector<HTMLElement>(sel);
      const tag = $('.tag')!;
      const text = $('[data-type]')!;
      seq.reveal($('.glow'), [{ opacity: 0, transform: 'scale(0.6)' }, { opacity: 1, transform: 'none' }], { duration: 900 });
      seq.reveal($('.avatar'), [{ opacity: 0, transform: 'translateY(28px) scale(0.92)' }, { opacity: 1, transform: 'none' }], {
        duration: 780,
        easing: EASE_SETTLE,
      });
      seq.reveal($('.dot'), pop, { duration: 320, delay: 380 });
      seq.reveal($('.line'), [{ transform: 'scaleY(0)' }, { transform: 'none' }], { duration: 460, delay: 440, easing: EASE_IN_OUT });
      seq.reveal(tag, [{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'none' }], { duration: 520, delay: 800 });
      (async () => {
        await seq.wait(980);
        tag.classList.add('is-typing');
        await seq.typeText(text, text.dataset.type!, 30);
        await seq.wait(600);
        tag.classList.remove('is-typing');
      })().catch(() => {});
    };

    onFirstView(root.querySelector('.frame')!, async () => {
      root.dataset.motion = 'playing';
      try {
        for (const h of root.querySelectorAll<HTMLElement>('.highlight')) {
          rise(h);
          await seq.wait(900);
        }
      } catch {}
    });
  }
</script>

<style>
  .cta {
    overflow: hidden;
    background: var(--bg-page);
  }

  .frame {
    position: relative;
    width: 1440px;
    height: 670px;
    margin-inline: auto;
    zoom: var(--fit, 1);
  }

  .wall {
    position: absolute;
    left: 150px;
    top: 152px;
    width: 1140px;
    height: 328px;
  }

  .wall img {
    width: 100%;
    height: 100%;
    /* The export has a light backdrop; darken drops it onto the page colour without a box. */
    mix-blend-mode: darken;
  }

  .highlight {
    position: absolute;
    width: 160px;
    height: 164px;
    animation: float 6s ease-in-out var(--delay) infinite;
  }

  @keyframes float {
    50% {
      transform: translateY(-4px);
    }
  }

  .glow {
    position: absolute;
    left: 14px;
    top: calc(var(--line) - 22px);
    width: 132px;
    height: 132px;
    max-width: none;
  }

  .line {
    position: absolute;
    left: 79.25px;
    top: 28px;
    width: 1.5px;
    height: var(--line);
    background: linear-gradient(180deg, rgba(30, 130, 224, 0.3), #1c38ea);
    transform-origin: 50% 100%;
  }

  .avatar {
    position: absolute;
    left: 54px;
    top: calc(var(--line) + 28px);
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 10.4px;
    background: var(--surface);
    box-shadow: 0 6px 18px 0 rgba(28, 56, 234, 0.35);
  }

  .avatar img {
    width: 49.4px;
    height: 49.4px;
    border-radius: 10.4px;
    object-fit: cover;
    opacity: 0.8;
  }

  .dot {
    position: absolute;
    left: 76.5px;
    top: calc(var(--line) + 23px);
  }

  .tag {
    position: absolute;
    top: 5px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px 4px 4px;
    border-radius: var(--r-md);
    background: var(--gradient-blue);
    box-shadow: 0 6px 14px 0 rgba(28, 56, 234, 0.28), var(--shadow-blue-inset);
    font-size: 12px;
    font-weight: 500;
    color: #fff;
    white-space: nowrap;
  }

  .tag-text {
    display: inline-flex;
    align-items: center;
  }

  /* While the label types, a caret follows it, like the hero's search field. */
  .tag-caret {
    display: none;
    width: 1.5px;
    height: 12px;
    margin-left: 1px;
    border-radius: 1px;
    background: #fff;
  }

  .tag.is-typing .tag-caret {
    display: block;
    animation: caret-blink 900ms steps(1) infinite;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  .tag-icon {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--surface);
  }

  .content {
    position: absolute;
    left: 50%;
    top: 328px;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateX(-50%);
    text-align: center;
  }

  h2 {
    font-size: 56px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -2.8px;
    white-space: nowrap;
  }

  .content p {
    margin-top: 32px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-body);
    white-space: nowrap;
  }

  .buttons {
    display: flex;
    gap: 12px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 24px;
    border-radius: var(--r-md);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    transition: transform var(--dur) var(--ease), filter var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn-primary {
    background: var(--btn-dark);
    color: #fff;
    box-shadow: var(--btn-dark-shadow);
  }

  .btn-primary:hover {
    background: var(--btn-dark-hover);
  }

  .btn-secondary {
    background: var(--btn-light);
    color: var(--text-primary);
    box-shadow: var(--btn-light-shadow);
  }

  .btn-secondary:hover {
    background: var(--btn-light-hover);
  }

  /* Mobile: show a strip of the wall above the copy. */
  @media (max-width: 767px) {
    .cta {
      padding: 56px var(--gutter) 72px;
    }

    .frame {
      zoom: 1;
      display: flex;
      flex-direction: column;
      width: 100%;
      height: auto;
    }

    .highlight {
      display: none;
    }

    .wall {
      position: relative;
      left: 50%;
      top: 0;
      width: 760px;
      /* The wall's centre is left empty for the desktop headline; keep only the full top rows. */
      height: 112px;
      overflow: hidden;
      transform: translateX(-50%);
      mask-image: linear-gradient(180deg, #000 55%, transparent);
      -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent);
    }

    .wall img {
      height: auto;
    }

    .content {
      position: static;
      transform: none;
      margin-top: 24px;
    }

    h2 {
      font-size: 40px;
      letter-spacing: -1.8px;
      white-space: normal;
    }

    .content p {
      margin-top: 20px;
      white-space: normal;
    }

    .br {
      display: none;
    }

    .buttons {
      flex-direction: column;
      align-self: stretch;
      margin-top: 28px;
    }
  }
</style>
