---
import { Image } from 'astro:assets';
import SendButton from './SendButton.astro';
import StrengthMeter from './StrengthMeter.astro';
import ThinkingBot from './ThinkingBot.astro';

import grain from '../assets/hero/grain.png';
import watercolor from '../assets/hero/watercolor.png';
import avatar1 from '../assets/hero/avatar-1.jpg';
import avatar2 from '../assets/hero/avatar-2.jpg';
import avatar3 from '../assets/hero/avatar-3.jpg';
import avatar4 from '../assets/hero/avatar-4.jpg';
import avatar5 from '../assets/hero/avatar-5.jpg';
import sarah from '../assets/hero/sarah-chen.png';
import rahul from '../assets/hero/rahul-mehta.png';
import emma from '../assets/hero/emma-liu.png';
import jack from '../assets/jobs/who-you-know/jack-ng.png';
import olivia from '../assets/jobs/who-you-know/olivia-yao.png';

const avatars = [
  { src: avatar1, pos: '52% 45%' },
  { src: avatar2, pos: '45% 30%' },
  { src: avatar3, pos: '50% 30%' },
  { src: avatar4, pos: '50% 45%' },
  { src: avatar5, pos: '50% 20%' },
];

const people = {
  sarah: { name: 'Sarah Chen', role: 'PM at Meta', photo: sarah, initial: 'D', via: 'via Daniel · classmate', tone: 'blue' },
  rahul: { name: 'Rahul Mehta', role: 'Recruiter at Meta', photo: rahul, initial: 'P', via: 'via Priya · ex-teammate', tone: 'green' },
  emma: { name: 'Emma Liu', role: 'Engineer at Meta', photo: emma, initial: 'A', via: 'via Alex · friend', tone: 'amber' },
  jack: { name: 'Jack Ng', role: 'Product Manager at Meta', photo: jack, initial: 'A', via: 'via Alex · friend', tone: 'amber' },
  olivia: { name: 'Olivia Yao', role: 'Staff Data Scientist at Meta', photo: olivia, initial: 'D', via: 'via Drew · ex-teammate', tone: 'green' },
} as const;

// One search, then two follow-ups that build on it, as on happenstance.ai. A follow-up is typed in
// the input; on submit the previous answer slides away under the input, the question lands in the
// box as a chat bubble, and its answer appears below in a form that suits the question.
const first = {
  query: 'Who do I know at Meta from my school?',
  rows: [
    { ...people.sarah, level: 'strong' },
    { ...people.rahul, level: 'good' },
    { ...people.emma, level: 'good' },
  ],
} as const;

// Follow-up 1 filters the same three people by team.
const filter = {
  query: 'Which of them work on product?',
  rows: [
    { ...people.sarah, team: 'Product', match: true },
    { ...people.rahul, team: 'Recruiting', match: false },
    { ...people.emma, team: 'Engineering', match: false },
  ],
} as const;

// Follow-up 2 drafts the intro request through the strongest mutual.
const draft = {
  query: 'Draft an intro to Sarah through Daniel',
  lead: 'Daniel is your warmest path to Sarah. Ready to send:',
  message:
    'Hi Daniel, I saw Sarah Chen is a PM at Meta now. I’m exploring product roles there and would love to hear how she finds it. Since you two were classmates, would you be open to introducing us?',
} as const;

const queries = [first.query, filter.query, draft.query];
---

<section class="hero" aria-labelledby="hero-title">
  <script is:inline>
    // Runs before the hero paints, so the intro starts from its empty state without a flash.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.currentScript.parentElement.dataset.intro = 'pending';
  </script>
  <div class="bg" aria-hidden="true">
    <div class="grain" style={`background-image:url(${grain.src});opacity:.25`}></div>
  </div>

  <div class="intro container">
    <div class="proof">
      <span class="proof-avatars" aria-hidden="true">
        {
          avatars.map((a) => (
            <span class="proof-avatar">
              <Image src={a.src} alt="" width={56} height={56} style={`object-position:${a.pos}`} loading="eager" />
            </span>
          ))
        }
      </span>
      <span class="proof-text">Loved by <strong>500,000+</strong> professionals</span>
    </div>

    <h1 id="hero-title">Your next job is already <br class="br" />in your network</h1>

    <p class="lead">
      Happenstance is an AI search engine for the network you actually have. Describe the job you want and find the
      people who can refer you.
    </p>

    <div class="prompt-wrap">
      <div class="art" aria-hidden="true">
        <Image src={watercolor} alt="" widths={[1376]} sizes="100vw" loading="eager" />
      </div>
      <div class="prompt" data-prompt>
        <p class="prompt-text display">
          <span class="prompt-typed" data-typed data-queries={JSON.stringify(queries)}>{first.query}</span><span
            class="caret"
            aria-hidden="true"></span>
        </p>
        <div class="prompt-actions"><SendButton label="Replay the search demo" /></div>
        <span class="prompt-progress" aria-hidden="true"></span>
      </div>
      <ThinkingBot tone="pill" class="prompt-think" />

      <!-- The answer comes out from under the input (pattern from exa.ai). -->
      <div class="answer intro-hide" data-answer>
        {/* 1 · The first answer: three warm paths. */}
        <div class="result is-current" data-result role="group" aria-label="Three warm paths to people at Meta">
          <p class="answer-head intro-hide">
            <span class="answer-label">3 warm paths at Meta</span>
            <span class="answer-meta">from <span data-count-to="1284">1,284</span> people mapped</span>
          </p>
          <ul class="paths">
            {
              first.rows.map((p, i) => (
                <li class:list={['path', 'intro-hide', { active: i === 0 }]}>
                  <Image class="path-photo" src={p.photo} alt="" width={40} height={40} densities={[1, 2]} />
                  <div class="path-info">
                    <p class="path-name">{p.name}</p>
                    <p class="path-role">{p.role}</p>
                    <p class="path-via">
                      <span class:list={['mutual', p.tone]}>{p.initial}</span>
                      {p.via}
                    </p>
                  </div>
                  <StrengthMeter level={p.level} />
                </li>
              ))
            }
          </ul>
        </div>

        {/* 2 · Follow-up: the same people, filtered by team. */}
        <div class="result" data-result role="group" aria-label="One of the three works on product">
          <p class="bubble intro-hide" data-bubble>{filter.query}</p>
          <p class="answer-head intro-hide">
            <span class="answer-label">1 of 3 works on product</span>
            <span class="answer-meta">filtered by team</span>
          </p>
          <ul class="paths">
            {
              filter.rows.map((p) => (
                <li class:list={['mini', 'intro-hide', { match: p.match }]}>
                  <Image class="mini-photo" src={p.photo} alt="" width={32} height={32} densities={[1, 2]} />
                  <p class="mini-info">
                    <span class="path-name">{p.name}</span>
                    <span class="path-role">{p.role}</span>
                  </p>
                  <span class="team">{p.team}</span>
                </li>
              ))
            }
          </ul>
        </div>

        {/* 3 · Follow-up: a drafted intro request. */}
        <div class="result" data-result role="group" aria-label="A drafted intro request to Sarah through Daniel">
          <p class="bubble intro-hide" data-bubble>{draft.query}</p>
          <p class="draft-lead intro-hide">{draft.lead}</p>
          <blockquote class="draft intro-hide">{draft.message}</blockquote>
          <p class="draft-foot intro-hide">
            <span class="path-via">
              <span class="mutual blue">D</span>
              To Daniel · classmate
            </span>
            <span class="draft-send">Send intro request</span>
          </p>
        </div>
      </div>

      {/* The CTA's buttons are their own layer above the card: the card's bottom edge runs in
          under a frosted strip, so the answer looks like it slides beneath the buttons. */}
      <div class="answer-cta intro-hide" data-cta>
        <span class="frost" aria-hidden="true"></span>
        <button class="btn btn-primary" type="button">Search for free</button>
        <button class="btn btn-secondary" type="button">Continue with Google</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHeroIntro } from '../scripts/hero-intro';
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) initHeroIntro(hero);
</script>

<style>
  .hero {
    position: relative;
    /* The header overlaps the hero in Figma; pull the hero up behind it. */
    margin-top: -64px;
    padding-top: 125px;
    padding-bottom: 76px;
    /* Same as the page behind the sections below, so there is no seam at the hero's edge. */
    background: var(--bg-page);
    overflow: hidden;
  }

  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .intro {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .proof {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 6px 12px 6px 6px;
    border-radius: var(--r-md);
    background: var(--surface);
    font-size: 14px;
    color: var(--text-body);
  }

  .proof-avatars {
    display: inline-flex;
  }

  .proof-avatar {
    width: 28px;
    height: 28px;
    margin-right: -8px;
    border: 2px solid var(--surface);
    border-radius: var(--r-sm);
    overflow: hidden;
  }

  .proof-avatar:last-child {
    margin-right: 0;
  }

  .proof-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .proof-text strong {
    font-weight: 600;
    color: var(--text-primary);
  }

  h1 {
    font-size: 56px;
    font-weight: 500;
    line-height: 60px;
    letter-spacing: -1.68px;
    padding-bottom: 12px;
  }

  .lead {
    max-width: 612px;
    font-size: 17px;
    line-height: 29.25px;
    color: var(--text-primary);
  }

  .prompt {
    position: relative;
    z-index: 2;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 96px;
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: 0 18px 48px -20px rgba(36, 55, 85, 0.3), 0 2px 4px 0 rgba(36, 55, 85, 0.07);
    text-align: left;
  }

  .prompt-text {
    padding: 17px 17px 0;
    height: 46px;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    letter-spacing: -0.15px;
  }

  .caret {
    display: inline-block;
    width: 1.2px;
    height: 14.74px;
    margin-left: 1px;
    vertical-align: -2px;
    border-radius: 1px;
    background: var(--blue-900);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* While characters are being typed the caret stays solid, like a real text field. */
  .prompt.is-typing .caret {
    animation: none;
  }

  .prompt.is-searching .caret {
    opacity: 0;
  }

  .prompt-actions {
    display: flex;
    justify-content: flex-end;
    padding: 12px;
  }

  /* Wraps the prompt, the thinking bot just below it, and the answer card. */
  .prompt-wrap {
    position: relative;
    z-index: 3;
    width: 525px;
    max-width: 100%;
    margin-top: 16px;
  }

  .prompt-wrap :global(.prompt-think) {
    position: absolute;
    z-index: 3;
    top: 106px;
    left: 0;
  }

  /* Thin "searching" sweep along the bottom edge of the prompt. */
  .prompt-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    opacity: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(30, 130, 224, 0), #1e82e0 35%, #1c38ea 65%, rgba(28, 56, 234, 0));
    background-size: 50% 100%;
    background-repeat: no-repeat;
  }

  /* ---- Intro sequence ----
     The server renders the finished Figma state. When scripting is available the hero starts
     with data-intro="pending", hiding the result pieces until the sequence reveals them. */
  .hero[data-intro='pending'] .prompt-typed {
    display: none;
  }

  .hero[data-intro] .intro-hide:not(.is-in) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero[data-intro] .intro-hide:not(.is-in) {
      opacity: 1;
    }

    .hero[data-intro='pending'] .prompt-typed {
      display: inline;
    }
  }

  /* ---- Background art ----
     A watercolor a little wider than the card, sitting behind its lower part so it only peeks
     out at the sides (pattern from littlebird.ai). It fades to nothing before its own edges. */
  .art {
    position: absolute;
    z-index: -1;
    left: 50%;
    bottom: -76px;
    /* A full-width landscape band, like a horizon behind the card: no shape of its own, so it
       never reads as a circle or a box. It rises softly out of the page and fades only at the
       far edges of the screen. */
    width: 100vw;
    height: 500px;
    translate: -50% 0;
    opacity: 0.85;
    pointer-events: none;
    --fade-y: linear-gradient(transparent, rgba(0, 0, 0, 0.35) 30%, #000 62%, #000 82%, transparent);
    --fade-x: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    mask-image: var(--fade-y), var(--fade-x);
    -webkit-mask-image: var(--fade-y), var(--fade-x);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep the mountains and lake (lower part of the painting) in the band on wide screens. */
    object-position: 50% 72%;
  }

  /* ---- Answer card ----
     Same width as the input and tucked 12px under it, so the answer reads as coming out of it. */
  .answer {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: -12px;
    padding: 28px 12px 12px;
    overflow: hidden;
    border-radius: 0 0 12px 12px;
    background: #fafafa;
    text-align: left;
  }

  /* Only the current answer takes space; follow-ups replace it at the same height. */
  .result {
    display: none;
    flex-direction: column;
    gap: 10px;
    /* The height of the first answer (label + three rows), so follow-ups never resize the card. */
    min-height: 264px;
  }

  /* A follow-up question, shown in the box the way a sent chat message is. */
  .bubble {
    align-self: flex-end;
    max-width: 100%;
    padding: 6px 12px;
    border-radius: 14px 14px 4px 14px;
    background: #ececee;
    font-size: 13px;
    font-weight: 500;
    line-height: 20px;
    color: var(--text-strong);
  }

  /* Follow-up 1: compact rows with a team tag; the match stays strong, the rest step back. */
  .mini {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 56px;
    padding: 0 12px 0 10px;
    border: 2px solid transparent;
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(36, 55, 85, 0.08), 0 4px 10px -6px rgba(36, 55, 85, 0.12);
  }

  .mini.match {
    border-color: var(--blue-700);
    box-shadow: 0 8px 24px -10px rgba(29, 92, 230, 0.35);
  }

  .mini:not(.match) > * {
    opacity: 0.45;
  }

  .mini-photo {
    width: 32px;
    height: 32px;
    border-radius: 50%;
  }

  .mini-info {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 1px;
  }

  .team {
    padding: 3px 9px;
    border-radius: var(--r-pill);
    background: var(--bg-subtle);
    font-size: 11px;
    font-weight: 500;
    color: var(--text-body);
    white-space: nowrap;
  }

  .mini.match .team {
    background: rgba(28, 56, 234, 0.08);
    color: var(--blue-900);
  }

  /* Follow-up 2: the drafted message. */
  .draft-lead {
    padding-inline: 2px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-strong);
  }

  .draft {
    padding: 12px 14px;
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(36, 55, 85, 0.08), 0 4px 10px -6px rgba(36, 55, 85, 0.12);
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-body);
  }

  .draft-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-inline: 2px;
  }

  .draft-send {
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: var(--gradient-blue);
    box-shadow: var(--shadow-blue-inset);
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
  }

  /* Between questions the input invites the next one. */
  .hero[data-intro='playing'] .prompt:not(.is-typing) .prompt-typed:empty::before {
    content: 'Ask a follow-up';
    color: var(--text-disabled);
  }

  .result.is-current {
    display: flex;
  }

  .answer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-inline: 2px;
    color: rgba(0, 0, 0, 0.4);
  }

  .answer-label {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  .answer-meta {
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .paths {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .path {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 76px;
    padding: 12px 14px 12px 12px;
    border: 2px solid transparent;
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(36, 55, 85, 0.08), 0 4px 10px -6px rgba(36, 55, 85, 0.12);
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .path.active {
    border-color: var(--blue-700);
    box-shadow: 0 8px 24px -10px rgba(29, 92, 230, 0.35);
  }

  .path:hover {
    transform: translateY(-2px);
  }

  .path-photo {
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }

  .path-info {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .path-name {
    font-size: 14px;
    font-weight: 600;
  }

  .path-role {
    font-size: 12px;
    color: var(--text-body);
  }

  .path-via {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-top: 2px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-strong);
    white-space: nowrap;
  }

  .mutual {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    font-size: 8px;
    font-weight: 600;
  }

  .mutual.blue {
    background: rgba(28, 56, 234, 0.08);
    color: var(--blue-900);
  }

  .mutual.green {
    background: rgba(21, 128, 61, 0.08);
    color: var(--green-700);
  }

  .mutual.amber {
    background: rgba(180, 83, 9, 0.08);
    color: var(--amber-700);
  }

  /* The last row fades into the panel. */
  /* A frosted strip over the bottom of the card: the last row blurs out under the buttons. */
  .answer-cta {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    /* Pulled up over the bottom of the card, which slides in underneath. */
    /* Its bottom lines up with the card's bottom edge (56 + 44 + 22 = 122). */
    margin-top: -122px;
    padding: 56px 0 22px;
  }

  /* Blur only, no fill: it spills past the card's bottom edge and fades out on every side, so the
     card's lower edge dissolves under the buttons without leaving a white band on the painting. */
  .frost {
    position: absolute;
    /* Reaches well past the card (as Intercom's Fin preview melts into its background), with a
       light mist of the page colour so the edge of the card and the painting blend smoothly. */
    inset: -24px -160px -110px;
    background: rgba(242, 242, 242, 0.45);
    /* Prefixed line first: the production CSS minifier keeps only the last of the two, and
       Chrome needs the unprefixed one (it dropped the blur on the live site before). */
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    /* Full strength across the card's side edges, fading only well outside them. */
    mask-image: linear-gradient(transparent, #000 40%, #000 80%, transparent),
      linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    mask-composite: intersect;
    -webkit-mask-image: linear-gradient(transparent, #000 40%, #000 80%, transparent),
      linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    -webkit-mask-composite: source-in;
    pointer-events: none;
  }

  /* Same buttons as the CTA section. They sit 24px below the strip's centre; the blur stays put. */
  .btn {
    position: relative;
    top: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 22px;
    border-radius: var(--r-md);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    transition: transform var(--dur) var(--ease), filter var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn-primary {
    background: var(--btn-dark);
    color: #fff;
    box-shadow: var(--btn-dark-shadow);
  }

  .btn-primary:hover {
    background: var(--btn-dark-hover);
  }

  .btn-secondary {
    background: var(--btn-light);
    color: var(--text-primary);
    box-shadow: var(--btn-light-shadow);
  }

  .btn-secondary:hover {
    background: var(--btn-light-hover);
  }

  @media (max-width: 767px) {
    .answer-cta {
      gap: 8px;
      padding-inline: 12px;
    }

    .btn {
      flex: 1;
      height: 42px;
      padding: 0 10px;
      font-size: 13px;
    }

    .hero {
      padding-top: 104px;
      padding-bottom: 56px;
    }

    h1 {
      font-size: 38px;
      line-height: 42px;
      letter-spacing: -1.1px;
      padding-bottom: 0;
    }

    .br {
      display: none;
    }

    .lead {
      font-size: 16px;
      line-height: 26px;
    }

    .proof-text {
      font-size: 13px;
    }

    .prompt-text {
      font-size: 13px;
    }

    .path {
      gap: 10px;
      padding-inline: 10px;
    }

    .path-via {
      font-size: 11px;
    }
  }
</style>
