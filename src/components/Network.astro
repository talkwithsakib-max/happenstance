---
import SectionHeading from './SectionHeading.astro';
import NetworkConnect from './NetworkConnect.astro';
import NetworkVisuals from './NetworkVisuals.astro';
import { Image } from 'astro:assets';
import grain from '../assets/hero/grain.png';
import backdrop from '../assets/network/backdrop.png';

const steps = [
  {
    title: 'Connect your accounts',
    stat: '5',
    statLabel: 'Accounts connected',
    long: 'Gmail, Calendar, LinkedIn, X, and more. Happenstance reads who you’ve emailed, met and followed, so nobody you know gets left out.',
    alt: 'Gmail, Calendar, X, LinkedIn and Outlook connect to your profile, adding thousands of people',
  },
  {
    title: 'Happenstance maps your network',
    stat: '178,683',
    statLabel: 'Connections mapped',
    long: 'Everyone you know is grouped by team, company and community, then ranked by how well you actually know them, wherever they are in the world.',
    alt: 'A world map of 178,683 connections grouped into communities and ranked by closeness',
  },
  {
    title: 'Add friends, join groups',
    stat: '18.4k',
    statLabel: 'Second-degree connections',
    long: 'Invite friends and join groups like your alumni network or YC batch. Their connections become searchable too, so you can find people two hops away.',
    alt: 'Your friends and groups expand your reach to 18.4k second-degree connections',
  },
  {
    title: 'Search for anyone',
    stat: '2 hops',
    statLabel: 'To the warmest intro',
    long: 'Describe who you need in plain English. Every result shows the warmest path in, through someone you already know.',
    alt: 'Searching “Top robotics founders in SF who are hiring” finds Leo Martins via Rahul Mehta',
  },
];
---

<section class="network container" aria-labelledby="network-title">
  <SectionHeading id="network-title">
    Your network is bigger<br /><span class="muted">than you think</span>
    <Fragment slot="lead">
      Connect your accounts, add friends, join groups. Every signal of who knows who becomes one searchable map.
    </Fragment>
  </SectionHeading>

  <div class="showcase" data-showcase data-interval="6000">
    {/* Left column: the active step with its controls on top, its headline figure at the bottom. */}
    <div class="copy">
      <div class="top">
        <ol class="steps">
          {
            steps.map((step, i) => (
              <li class:list={['step', { 'is-active': i === 0 }]} data-step={i}>
                <p class="count" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')} / {String(steps.length).padStart(2, '0')}
                </p>
                <h3 class="title">{step.title}</h3>
                <p class="desc">{step.long}</p>
              </li>
            ))
          }
        </ol>

        <div class="controls">
          <div class="progress" role="group" aria-label="Steps">
            {
              steps.map((step, i) => (
                <button
                  class:list={['head', { 'is-active': i === 0 }]}
                  type="button"
                  data-goto={i}
                  aria-label={`Step ${i + 1}: ${step.title}`}
                  aria-current={i === 0 ? 'step' : undefined}
                >
                  <span class="fill" />
                </button>
              ))
            }
          </div>
          <button class="pause" type="button" data-pause aria-label="Pause autoplay" aria-pressed="false">
            <span class="icon-pause" aria-hidden="true">
              <i />
              <i />
            </span>
            <span class="icon-play" aria-hidden="true" />
          </button>
        </div>
      </div>

      <div class="stats">
        {
          steps.map((step, i) => (
            <p class:list={['stat', { 'is-active': i === 0 }]} data-stat={i}>
              <span class="stat-value">{step.stat}</span>
              <span class="stat-label">{step.statLabel}</span>
            </p>
          ))
        }
      </div>
    </div>

    {/* Same recipe as the Job seekers cards: a painted tile with grain and a sheen, and the
        visual on a clean white panel (two glass sheets tucked behind it) so it stays readable. */}
    <div class="tile">
      <div class="backdrop" aria-hidden="true">
        <Image src={backdrop} alt="" widths={[700, 1024]} sizes="(max-width: 1100px) 100vw, 660px" loading="lazy" />
        <div class="grain" style={`background-image:url(${grain.src});background-size:128px 128px;opacity:.35`}></div>
        <div class="sheen"></div>
      </div>
      <div class="panel-wrap">
        <span class="glass glass-back" aria-hidden="true"></span>
        <span class="glass glass-mid" aria-hidden="true"></span>
        <div class="panel visual">
          <NetworkConnect label={steps[0].alt} active />
          <NetworkVisuals labels={steps.slice(1).map((s) => s.alt)} />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initConnect } from '../scripts/network-connect';
  import { initMap, initFriends, initSearch } from '../scripts/network-steps';

  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>('.step')];
    const heads = [...root.querySelectorAll<HTMLButtonElement>('.head')];
    const stats = [...root.querySelectorAll<HTMLElement>('.stat')];
    const frames = [...root.querySelectorAll<HTMLElement>('[data-frame]')];
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const interval = Number(root.dataset.interval) || 6000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const frameEl = (i: number) => root.querySelector<HTMLElement>(`[data-frame="${i}"]`)!;
    const players = reduceMotion
      ? []
      : [initConnect(frameEl(0)), initMap(frameEl(1)), initFriends(frameEl(2)), initSearch(frameEl(3))];
    const visual = root.querySelector<HTMLElement>('.visual')!;

    let current = 0;
    let paused = reduceMotion;
    let onscreen = false;

    // The step visuals are live HTML at Figma's size; scale them to the panel.
    new ResizeObserver(() => {
      const fit = Math.min(visual.clientWidth / 650, visual.clientHeight / 560);
      visual.style.setProperty('--cx-fit', String(Math.min(1, fit)));
    }).observe(visual);

    // Each step's animation runs only while that step is showing and on screen.
    const syncPlayers = () => players.forEach((p, i) => p.toggle(i === current && onscreen));
    root.style.setProperty('--step-duration', `${interval}ms`);

    const restartFill = () => {
      const fill = heads[current].querySelector<HTMLElement>('.fill')!;
      fill.style.animation = 'none';
      void fill.offsetWidth; // restart the CSS animation
      fill.style.animation = '';
    };

    const go = (index: number) => {
      current = (index + steps.length) % steps.length;
      steps.forEach((step, i) => step.classList.toggle('is-active', i === current));
      frames.forEach((frame, i) => frame.classList.toggle('is-active', i === current));
      stats.forEach((stat, i) => stat.classList.toggle('is-active', i === current));
      heads.forEach((head, i) => {
        head.classList.toggle('is-active', i === current);
        if (i === current) head.setAttribute('aria-current', 'step');
        else head.removeAttribute('aria-current');
      });
      restartFill();
      syncPlayers();
    };

    const setPaused = (value: boolean) => {
      paused = value;
      root.classList.toggle('is-paused', paused);
      pauseBtn.setAttribute('aria-pressed', String(paused));
      pauseBtn.setAttribute('aria-label', paused ? 'Resume autoplay' : 'Pause autoplay');
    };

    heads.forEach((head, i) => {
      head.addEventListener('click', () => go(i));
      head.querySelector('.fill')!.addEventListener('animationend', () => {
        if (!paused) go(current + 1);
      });
    });

    pauseBtn.addEventListener('click', () => setPaused(!paused));

    // Only run the timer while the showcase is on screen.
    new IntersectionObserver(([entry]) => {
      onscreen = entry.isIntersecting;
      root.classList.toggle('is-offscreen', !onscreen);
      syncPlayers();
    }).observe(root);

    setPaused(paused);
  });
</script>

<style>
  .network {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: var(--section-y);
  }

  /* Open layout: copy straight on the page on the left, one painted tile on the right. */
  .showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 720px;
    gap: 64px;
  }

  .tile {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 560px;
    padding: 36px 60px;
    overflow: hidden;
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-card);
    isolation: isolate;
  }

  .backdrop,
  .backdrop img,
  .sheen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .backdrop {
    z-index: -1;
  }

  .backdrop img {
    object-fit: cover;
  }

  .sheen {
    mix-blend-mode: soft-light;
    background: repeating-linear-gradient(
      121.68deg,
      rgba(255, 255, 255, 0) 0,
      rgba(255, 255, 255, 0.35) 13.8px,
      rgba(255, 255, 255, 0) 32px,
      rgba(255, 255, 255, 0) 53.6px
    );
  }

  /* Copy */
  .copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding: 8px 0 4px 28px;
  }

  .top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  /* All steps share one cell, so the column keeps its height as they change. */
  .steps,
  .stats {
    display: grid;
    width: 100%;
  }

  .step,
  .stat {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
  }

  .step.is-active,
  .stat.is-active {
    visibility: visible;
    opacity: 1;
    animation: rise 500ms var(--ease) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .count {
    font-size: 13px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--text-faint);
  }

  .title {
    font-size: 28px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.7px;
    color: var(--text-primary);
  }

  .desc {
    max-width: 400px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-body);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stat-value {
    font-size: 72px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -3px;
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }

  .stat-label {
    font-size: 15px;
    color: var(--text-body);
  }

  /* Progress + pause */
  .controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .progress {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    padding-inline: 16px;
    border-radius: var(--r-pill);
    background: var(--divider);
  }

  .head {
    position: relative;
    width: 5px;
    height: 5px;
    overflow: hidden;
    border-radius: 3px;
    background: var(--text-primary);
    transition: width 300ms var(--ease), background-color var(--dur) var(--ease);
  }

  /* A larger hit area than the dot itself. */
  .head::after {
    content: '';
    position: absolute;
    inset: -12px -4px;
  }

  .head.is-active {
    width: 48px;
    height: 4px;
    background: #c3c7cf;
  }

  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: 3px;
    background: var(--text-primary);
  }

  .head.is-active .fill {
    animation: fill var(--step-duration, 6s) linear forwards;
  }

  .is-paused .head.is-active .fill,
  .is-offscreen .head.is-active .fill {
    animation-play-state: paused;
  }

  @keyframes fill {
    to {
      width: 100%;
    }
  }

  .pause {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--divider);
    transition: background-color var(--dur) var(--ease);
  }

  .pause:hover {
    background: #d5d8de;
  }

  .icon-pause {
    display: flex;
    gap: 3px;
  }

  .icon-pause i {
    width: 2.5px;
    height: 10px;
    border-radius: 1px;
    background: var(--text-primary);
  }

  .icon-play {
    display: none;
    width: 0;
    height: 0;
    margin-left: 2px;
    border-block: 5px solid transparent;
    border-left: 8px solid var(--text-primary);
  }

  .is-paused .icon-pause {
    display: none;
  }

  .is-paused .icon-play {
    display: block;
  }

  /* Visual panel */
  .panel-wrap {
    position: relative;
    width: 100%;
    padding-top: 20px;
  }

  .glass {
    position: absolute;
    height: 40px;
    border-radius: 12px 12px 0 0;
    background: rgba(255, 255, 255, 0.55);
  }

  .glass-back {
    top: 0;
    inset-inline: 36px;
    background: rgba(255, 255, 255, 0.35);
  }

  .glass-mid {
    top: 10px;
    inset-inline: 18px;
  }

  .panel {
    position: relative;
    height: 468px;
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 24px 48px -28px rgba(36, 55, 85, 0.45), 0 2px 6px rgba(36, 55, 85, 0.08);
  }

  .visual :global(.frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: scale(1.01);
    transition: opacity 500ms var(--ease), transform 700ms var(--ease);
  }

  .visual :global(.frame.is-active) {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 1240px) {
    .showcase {
      grid-template-columns: minmax(0, 1fr) 600px;
      gap: 40px;
    }

    .tile {
      padding: 28px 32px;
    }
  }

  @media (max-width: 1000px) {
    .showcase {
      display: flex;
      flex-direction: column-reverse;
      gap: 28px;
    }

    .tile {
      min-height: 0;
      padding: 28px;
    }

    .panel-wrap {
      max-width: 600px;
    }

    .panel {
      height: auto;
      aspect-ratio: 600 / 468;
    }

    .copy {
      gap: 28px;
      padding: 0 4px;
    }
  }

  @media (max-width: 767px) {
    .network {
      gap: 40px;
    }

    .tile {
      padding: 14px 14px 18px;
    }

    .title {
      font-size: 24px;
    }

    .stat-value {
      font-size: 52px;
      letter-spacing: -2px;
    }
  }
</style>
