---
import SectionHeading from './SectionHeading.astro';
import NetworkConnect from './NetworkConnect.astro';
import NetworkVisuals from './NetworkVisuals.astro';
import { Image } from 'astro:assets';
import grain from '../assets/hero/grain.png';
import backdrop from '../assets/network/backdrop.png';

const steps = [
  {
    title: 'Connect your accounts',
    long: 'Gmail, Calendar, LinkedIn, X, and more. Happenstance reads who you’ve emailed, met and followed, so nobody you know gets left out.',
    alt: 'Gmail, Calendar, X, LinkedIn and Outlook connect to your profile, adding thousands of people',
  },
  {
    title: 'Happenstance maps your network',
    long: 'Everyone you know is grouped by team, company and community, then ranked by how well you actually know them, wherever they are in the world.',
    alt: 'A world map of 178,683 connections grouped into communities and ranked by closeness',
  },
  {
    title: 'Add friends, join groups',
    long: 'Invite friends and join groups like your alumni network or YC batch. Their connections become searchable too, so you can find people two hops away.',
    alt: 'Your friends and groups expand your reach to 18.4k second-degree connections',
  },
  {
    title: 'Search for anyone',
    long: 'Describe who you need in plain English. Every result shows the warmest path in, through someone you already know.',
    alt: 'Searching “Top robotics founders in SF who are hiring” finds Leo Martins via Rahul Mehta',
  },
];
---

<section class="network container" aria-labelledby="network-title">
  <SectionHeading id="network-title">
    Your network is bigger<br /><span class="muted">than you think</span>
    <Fragment slot="lead">
      Connect your accounts, add friends, join groups. Every signal of who knows who becomes one searchable map.
    </Fragment>
  </SectionHeading>

  <div class="showcase" data-showcase data-interval="6000" data-tone="0">
    {/* One soft gradient per step, cross-faded as the steps change. */}
    <div class="backdrop" aria-hidden="true">
      {steps.map((_, i) => <div class={`wash wash-${i}`} />)}
      <Image class="art" src={backdrop} alt="" widths={[1232, 1792]} sizes="(max-width: 1232px) 100vw, 1232px" loading="lazy" />
      <div class="grain" style={`background-image:url(${grain.src});opacity:.45`}></div>
    </div>

    <div class="copy">
      <ol class="steps">
        {
          steps.map((step, i) => (
            <li class:list={['step', { 'is-active': i === 0 }]} data-step={i}>
              <h3>
                <button class="head" type="button" data-goto={i} aria-current={i === 0 ? 'step' : undefined}>
                  <span class="num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="title">{step.title}</span>
                </button>
              </h3>
              <div class="body">
                <div class="body-inner">
                  <p class="desc">{step.long}</p>
                  <span class="rail" aria-hidden="true">
                    <span class="fill" />
                  </span>
                </div>
              </div>
            </li>
          ))
        }
      </ol>

      <button class="pause" type="button" data-pause aria-label="Pause autoplay" aria-pressed="false">
        <span class="icon-pause" aria-hidden="true">
          <i />
          <i />
        </span>
        <span class="icon-play" aria-hidden="true" />
      </button>
    </div>

    {/* The visual sits on a clean white panel, with two glass sheets tucked behind it. */}
    <div class="panel-wrap">
      <span class="glass glass-back" aria-hidden="true"></span>
      <span class="glass glass-mid" aria-hidden="true"></span>
      <div class="panel visual">
        <NetworkConnect label={steps[0].alt} active />
        <NetworkVisuals labels={steps.slice(1).map((s) => s.alt)} />
      </div>
    </div>
  </div>
</section>

<script>
  import { initConnect } from '../scripts/network-connect';
  import { initMap, initFriends, initSearch } from '../scripts/network-steps';

  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>('.step')];
    const heads = steps.map((step) => step.querySelector<HTMLButtonElement>('.head')!);
    const frames = [...root.querySelectorAll<HTMLElement>('[data-frame]')];
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const interval = Number(root.dataset.interval) || 6000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const frameEl = (i: number) => root.querySelector<HTMLElement>(`[data-frame="${i}"]`)!;
    const players = reduceMotion
      ? []
      : [initConnect(frameEl(0)), initMap(frameEl(1)), initFriends(frameEl(2)), initSearch(frameEl(3))];
    const visual = root.querySelector<HTMLElement>('.visual')!;

    let current = 0;
    let paused = reduceMotion;
    let onscreen = false;

    // The step visuals are live HTML at Figma's size; scale them to the panel.
    new ResizeObserver(() => {
      const fit = Math.min(visual.clientWidth / 650, visual.clientHeight / 560);
      visual.style.setProperty('--cx-fit', String(Math.min(1, fit)));
    }).observe(visual);

    // Each step's animation runs only while that step is showing and on screen.
    const syncPlayers = () => players.forEach((p, i) => p.toggle(i === current && onscreen));
    root.style.setProperty('--step-duration', `${interval}ms`);

    const restartFill = () => {
      const fill = steps[current].querySelector<HTMLElement>('.fill')!;
      fill.style.animation = 'none';
      void fill.offsetWidth; // restart the CSS animation
      fill.style.animation = '';
    };

    const go = (index: number) => {
      current = (index + steps.length) % steps.length;
      root.dataset.tone = String(current);
      steps.forEach((step, i) => step.classList.toggle('is-active', i === current));
      frames.forEach((frame, i) => frame.classList.toggle('is-active', i === current));
      heads.forEach((head, i) => {
        if (i === current) head.setAttribute('aria-current', 'step');
        else head.removeAttribute('aria-current');
      });
      restartFill();
      syncPlayers();
    };

    const setPaused = (value: boolean) => {
      paused = value;
      root.classList.toggle('is-paused', paused);
      pauseBtn.setAttribute('aria-pressed', String(paused));
      pauseBtn.setAttribute('aria-label', paused ? 'Resume autoplay' : 'Pause autoplay');
    };

    steps.forEach((step, i) => {
      heads[i].addEventListener('click', () => go(i));
      step.querySelector('.fill')!.addEventListener('animationend', () => {
        if (!paused) go(current + 1);
      });
    });

    pauseBtn.addEventListener('click', () => setPaused(!paused));

    // Only run the timer while the showcase is on screen.
    new IntersectionObserver(([entry]) => {
      onscreen = entry.isIntersecting;
      root.classList.toggle('is-offscreen', !onscreen);
      syncPlayers();
    }).observe(root);

    setPaused(paused);
  });
</script>

<style>
  .network {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: var(--section-y);
  }

  /* One gradient card: the steps on the left, the visual on a white panel on the right. */
  .showcase {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 600px;
    gap: 40px;
    min-height: 560px;
    padding: 36px 36px 36px 28px;
    overflow: hidden;
    border-radius: var(--r-xl);
    background: #cfe0f5;
  }

  .backdrop,
  .wash {
    position: absolute;
    inset: 0;
  }

  .wash {
    opacity: 0;
    transition: opacity 800ms var(--ease);
  }

  [data-tone='0'] .wash-0,
  [data-tone='1'] .wash-1,
  [data-tone='2'] .wash-2,
  [data-tone='3'] .wash-3 {
    opacity: 1;
  }

  .wash-0 {
    background:
      radial-gradient(60% 80% at 0% 100%, #8ed8b4, transparent 70%),
      radial-gradient(55% 75% at 100% 0%, #e6dcfb, transparent 70%),
      radial-gradient(60% 70% at 100% 100%, #a8c6f4, transparent 70%),
      linear-gradient(135deg, #a9dcd6, #c9d6f6);
  }

  .wash-1 {
    background:
      radial-gradient(60% 80% at 0% 100%, #b9c3fa, transparent 70%),
      radial-gradient(55% 75% at 100% 0%, #f8d5e8, transparent 70%),
      radial-gradient(60% 70% at 100% 100%, #d6c4fa, transparent 70%),
      linear-gradient(135deg, #cfd3fb, #ead9f8);
  }

  .wash-2 {
    background:
      radial-gradient(60% 80% at 0% 100%, #92c1f8, transparent 70%),
      radial-gradient(55% 75% at 100% 0%, #d3f0f2, transparent 70%),
      radial-gradient(60% 70% at 100% 100%, #c2c4fb, transparent 70%),
      linear-gradient(135deg, #b4d6fa, #cfdcfb);
  }

  .wash-3 {
    background:
      radial-gradient(60% 80% at 0% 100%, #f9c9d8, transparent 70%),
      radial-gradient(55% 75% at 100% 0%, #fde3cb, transparent 70%),
      radial-gradient(60% 70% at 100% 100%, #dccdfb, transparent 70%),
      linear-gradient(135deg, #f8d6dc, #ecd9f6);
  }

  /* A watercolor landscape, multiplied into the gradient so it takes each step's colour. */
  .backdrop :global(.art) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
    mix-blend-mode: multiply;
    filter: contrast(1.25) saturate(1.2);
    opacity: 0.9;
  }

  /* Steps */
  .copy {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding-block: 4px 0;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  /* Each step is a row; the active one opens into a frosted card. */
  .step {
    padding: 4px 20px;
    border-radius: 14px;
    transition: background-color 400ms var(--ease), padding 400ms var(--ease), box-shadow 400ms var(--ease);
  }

  .step.is-active {
    padding: 14px 20px 8px;
    background: rgba(255, 255, 255, 0.55);
    box-shadow: 0 18px 36px -24px rgba(36, 55, 85, 0.4), inset 0 0 0 1px rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    width: 100%;
    padding-block: 12px;
    text-align: left;
    color: rgba(10, 10, 10, 0.6);
    transition: color var(--dur) var(--ease);
  }

  .head:hover {
    color: rgba(10, 10, 10, 0.7);
  }

  .step.is-active .head {
    color: var(--text-primary);
    cursor: default;
  }

  .num {
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .title {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.5px;
  }

  .step.is-active .title {
    font-size: 28px;
    letter-spacing: -0.7px;
    line-height: 1.15;
  }

  .body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 500ms var(--ease);
  }

  .step.is-active .body {
    grid-template-rows: 1fr;
  }

  .body-inner {
    min-height: 0;
    overflow: hidden;
    padding-left: 32px;
    opacity: 0;
    transition: opacity 400ms var(--ease);
  }

  .step.is-active .body-inner {
    opacity: 1;
  }

  .desc {
    font-size: 16px;
    line-height: 1.55;
    color: rgba(10, 10, 10, 0.7);
  }

  .rail {
    position: relative;
    display: block;
    width: 100%;
    height: 3px;
    margin-block: 18px 12px;
    overflow: hidden;
    border-radius: 2px;
    background: rgba(10, 10, 10, 0.12);
  }

  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: 2px;
    background: var(--text-primary);
  }

  .step.is-active .fill {
    animation: fill var(--step-duration, 6s) linear forwards;
  }

  .is-paused .step.is-active .fill,
  .is-offscreen .step.is-active .fill {
    animation-play-state: paused;
  }

  @keyframes fill {
    to {
      width: 100%;
    }
  }

  .pause {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-left: 20px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.7);
    transition: background-color var(--dur) var(--ease);
  }

  .pause:hover {
    background: #fff;
  }

  .icon-pause {
    display: flex;
    gap: 3px;
  }

  .icon-pause i {
    width: 2.5px;
    height: 10px;
    border-radius: 1px;
    background: var(--text-primary);
  }

  .icon-play {
    display: none;
    width: 0;
    height: 0;
    margin-left: 2px;
    border-block: 5px solid transparent;
    border-left: 8px solid var(--text-primary);
  }

  .is-paused .icon-pause {
    display: none;
  }

  .is-paused .icon-play {
    display: block;
  }

  /* Visual panel */
  .panel-wrap {
    position: relative;
    align-self: center;
    padding-top: 20px;
  }

  .glass {
    position: absolute;
    height: 40px;
    border-radius: 12px 12px 0 0;
    background: rgba(255, 255, 255, 0.45);
  }

  .glass-back {
    top: 0;
    inset-inline: 36px;
    background: rgba(255, 255, 255, 0.3);
  }

  .glass-mid {
    top: 10px;
    inset-inline: 18px;
  }

  .panel {
    position: relative;
    height: 468px;
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 24px 48px -28px rgba(36, 55, 85, 0.45), 0 2px 6px rgba(36, 55, 85, 0.08);
  }

  .visual :global(.frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: scale(1.01);
    transition: opacity 500ms var(--ease), transform 700ms var(--ease);
  }

  .visual :global(.frame.is-active) {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 1100px) {
    .showcase {
      display: flex;
      flex-direction: column-reverse;
      gap: 28px;
      min-height: 0;
      padding: 28px;
    }

    .panel-wrap {
      align-self: stretch;
      width: 100%;
      max-width: 600px;
      margin-inline: auto;
    }

    .panel {
      height: auto;
      aspect-ratio: 600 / 468;
    }

    .copy {
      padding: 0;
    }
  }

  @media (max-width: 767px) {
    .network {
      gap: 40px;
    }

    .showcase {
      padding: 16px 16px 24px;
    }

    .head {
      gap: 10px;
      padding-block: 8px;
    }

    .step {
      padding-inline: 14px;
    }

    .step.is-active {
      padding: 10px 14px 6px;
    }

    .title {
      font-size: 18px;
    }

    .desc {
      font-size: 15px;
    }

    .step.is-active .title {
      font-size: 22px;
    }

    .body-inner {
      padding-left: 27px;
    }
  }
</style>
