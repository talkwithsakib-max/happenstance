---
import { Image } from 'astro:assets';
import type { Answer } from '../data/faq';
import { allQuestions } from '../data/faq';
import search from '../assets/icons/search.svg?url';

interface Props {
  answer: Answer;
}

const { answer } = Astro.props;
const answered = new Set(allQuestions.filter((q) => q.answer).map((q) => q.number));
---

<div class="reply">
  <p class="text" data-stream>{answer.text}</p>

  {
    answer.example && (
      <div class="example m-hide">
        <p class="query m-hide">
          <img src={search} alt="" width="16" height="16" />
          <span data-type={answer.example.query}>{answer.example.query}</span>
        </p>
        {answer.example.results.map((r) => (
          <div class="person m-hide">
            <Image src={r.photo} alt="" width={40} height={40} densities={[1, 2]} class="person-photo" loading="lazy" />
            <div class="person-info">
              <p class="person-name display">{r.name}</p>
              <p class="person-detail">{r.detail}</p>
            </div>
            <span class="via m-hide">
              <Image src={r.viaPhoto} alt="" width={20} height={20} densities={[1, 2]} loading="lazy" />
              {r.via}
            </span>
          </div>
        ))}
      </div>
    )
  }

  {
    answer.askNext && (
      <div class="next m-hide">
        <p class="next-label">Ask next</p>
        <div class="chips">
          {answer.askNext.map((n) => {
            const q = allQuestions.find((item) => item.number === n)!;
            return answered.has(n) ? (
              <button class="chip m-hide" type="button" data-ask={n}>
                {q.question}
              </button>
            ) : (
              <span class="chip m-hide">{q.question}</span>
            );
          })}
        </div>
      </div>
    )
  }
</div>

<style>
  .reply {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-reply);
  }

  /* The example search: one compact panel lifted off the card by its shadow (no borders),
     the query on top and slim result rows below. */
  .example {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 4px 4px 4px;
    border-radius: var(--r-md);
    background: var(--bg-soft);
    box-shadow: 0 10px 24px -14px rgba(36, 55, 85, 0.28), 0 1px 3px rgba(36, 55, 85, 0.08);
  }

  .query {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 10px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-strong);
  }

  .query img {
    width: 14px;
    height: 14px;
  }

  .person {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 10px;
    border-radius: 6px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(36, 55, 85, 0.08);
  }

  .person-photo {
    width: 28px;
    height: 28px;
    border-radius: 50%;
  }

  /* Name and role share one line. */
  .person-info {
    display: flex;
    flex: 1;
    min-width: 0;
    align-items: baseline;
    gap: 6px;
    white-space: nowrap;
  }

  .person-name {
    font-size: 13px;
    font-weight: 600;
  }

  .person-detail {
    overflow: hidden;
    font-size: 12px;
    color: var(--text-faint);
    text-overflow: ellipsis;
  }

  .via {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px 2px 3px;
    border-radius: var(--r-xs);
    background: var(--bg-subtle);
    font-size: 11.5px;
    font-weight: 500;
    color: var(--text-strong);
    white-space: nowrap;
  }

  .via img {
    width: 18px;
    height: 18px;
    border-radius: 50%;
  }

  /* "Ask next" sits on the same row as its suggestions. */
  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .next-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 9px;
    border-radius: var(--r-md);
    background: var(--bg-soft);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-primary);
  }

  button.chip {
    transition: background-color var(--dur) var(--ease);
  }

  button.chip:hover {
    background: var(--divider);
  }

  @media (max-width: 767px) {
    .text {
      font-size: 15px;
    }
  }
</style>
