---
import Logo from './Logo.astro';

// Pages behind these items are not designed yet, so they render without a destination.
const items = ['Product', 'Use cases', 'Pricing', 'Careers'];
---

<header class="header">
  <div class="container nav">
    <span aria-label="Happenstance home"><Logo /></span>
    <nav aria-label="Primary">
      <ul class="links">
        {items.map((item) => <li><span class="link">{item}</span></li>)}
      </ul>
    </nav>
    <button class="signup" type="button">Sign up</button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 64px;
  }

  nav {
    flex: 1;
    padding-left: 24px;
  }

  .links {
    display: flex;
    gap: 4px;
  }

  .link {
    display: inline-flex;
    padding: 6px 12px;
    border-radius: var(--r-md);
    font-size: 14px;
    font-weight: 500;
    line-height: 19.5px;
    color: var(--text-primary);
    cursor: default;
    transition: background-color var(--dur) var(--ease);
  }

  .link:hover {
    background: rgba(10, 10, 10, 0.05);
  }

  .signup {
    padding: 10px 18px;
    border-radius: var(--r-md);
    background: var(--text-primary);
    color: var(--bg-soft);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    transition: background-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .signup:hover {
    background: #2a2a2e;
  }

  .signup:active {
    transform: translateY(1px);
  }

  @media (max-width: 767px) {
    nav {
      display: none;
    }

    .nav {
      justify-content: space-between;
    }
  }
</style>
