---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import SendButton from './SendButton.astro';
import FaqAnswer from './FaqAnswer.astro';
import ThinkingBot from './ThinkingBot.astro';
import BotMark from './BotMark.astro';
import { faqGroups, allQuestions, initialQuestion } from '../data/faq';

import you from '../assets/faq/you.png';
import arrow from '../assets/faq/arrow-blue.svg?url';

const total = String(allQuestions.length).padStart(2, '0');
// The tab that opens first is the one holding the opening question.
const initialGroup = Math.max(0, faqGroups.findIndex((g) => g.questions.some((q) => q.number === initialQuestion)));
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="faq container" aria-labelledby="faq-title">
  <SectionHeading id="faq-title" leadWidth={540}>
    <span class="muted">Questions?</span> Just ask.
    <Fragment slot="lead">
      Everything people ask before their first search, answered the way Happenstance answers everything: in plain
      English.
    </Fragment>
  </SectionHeading>

  <div class="layout" data-faq data-active={initialQuestion}>
    <div class="questions">
      <!-- Topic tabs. Without scripting they stay hidden and every group shows with its label. -->
      <div class="tabs" role="tablist" aria-label="Question topics">
        {
          faqGroups.map((group, i) => (
            <button
              class:list={['tab', { 'is-active': i === initialGroup }]}
              type="button"
              role="tab"
              id={`faq-tab-${i}`}
              aria-selected={i === initialGroup ? 'true' : 'false'}
              aria-controls={`faq-group-${i}`}
              data-tab={i}
            >
              <span class="tab-inner">{group.label}</span>
            </button>
          ))
        }
      </div>
      {
        faqGroups.map((group, i) => (
          <div class="group" id={`faq-group-${i}`} role="tabpanel" aria-labelledby={`faq-tab-${i}`} data-group={i}>
            <p class="group-label">{group.label}</p>
            <ul>
              {group.questions.map((q) => (
                <li class:list={['item', { 'is-active': q.number === initialQuestion }]} data-item={q.number}>
                  {q.answer ? (
                    <button
                      class="q"
                      type="button"
                      data-ask={q.number}
                      aria-expanded={q.number === initialQuestion ? 'true' : 'false'}
                      aria-controls={`faq-inline-${q.number}`}
                    >
                      <span class="num">{pad(q.number)}</span>
                      <span class="label display">{q.question}</span>
                      <img class="arrow" src={arrow} alt="" width="16" height="16" />
                    </button>
                  ) : (
                    <p class="q">
                      <span class="num">{pad(q.number)}</span>
                      <span class="label display">{q.question}</span>
                    </p>
                  )}
                  {q.answer && (
                    <div class="inline" id={`faq-inline-${q.number}`} role="region" aria-label={q.question}>
                      <div class="inline-inner" data-motion data-answer>
                        <FaqAnswer answer={q.answer} />
                      </div>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="contact">Can’t find it? <span class="contact-link">Contact us</span></p>
    </div>

    <div class="card" aria-live="polite">
      <div class="card-head">
        <span class="mark"><BotMark size={18} /></span>
        <p class="card-title display">Ask Happenstance</p>
        <p class="card-count"><span data-count>{pad(initialQuestion)}</span> / {total}</p>
      </div>

      {
        allQuestions
          .filter((q) => q.answer)
          .map((q) => (
            <div class="thread" data-thread={q.number} data-motion data-answer hidden={q.number !== initialQuestion}>
              <div class="you">
                <p class="bubble m-hide">{q.question}</p>
                <Image src={you} alt="" width={32} height={32} densities={[1, 2]} class="you-photo m-hide" />
              </div>
              <div class="answer">
                <span class="mark m-hide"><BotMark size={18} /></span>
                <ThinkingBot class="thinking-slot" />
                <FaqAnswer answer={q.answer!} />
              </div>
            </div>
          ))
      }

      <div class="ask" aria-hidden="true">
        <span class="ask-field">
          <span class="ask-placeholder">Ask anything about Happenstance…</span>
          <span class="ask-typed" data-ask-typed></span><span class="ask-caret"></span>
        </span>
        <SendButton label="Ask" />
      </div>
    </div>
  </div>

  <script is:inline>
    // Lets answers build in sequence only when motion is allowed.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
      document.currentScript.parentElement.querySelectorAll('[data-answer]').forEach((el) => (el.dataset.motion = 'pending'));
  </script>
</section>

<script>
  import { createSequence, onFirstView, reducedMotion, rise, fadeUp, pop, EASE_SETTLE } from '../scripts/motion';

  type Seq = ReturnType<typeof createSequence>;

  // Chat-style answer: question bubble, the Happenstance bot thinking, the reply streaming in word by
  // word, then the example search and the follow-up suggestions.
  const playAnswer = async (root: HTMLElement, s: Seq) => {
    s.reset();
    root.dataset.motion = 'playing';
    const $ = (sel: string) => root.querySelector<HTMLElement>(sel);
    const bubble = $('.bubble');
    let start = 80;

    if (bubble) {
      s.reveal(bubble, [{ opacity: 0, transform: 'translateX(12px)' }, { opacity: 1, transform: 'none' }], { duration: 460 });
      s.reveal($('.you-photo'), pop, { duration: 460, delay: 120, easing: EASE_SETTLE });
      // The Happenstance bot thinks where the mark sits, then hands over to the mark and the reply.
      const replyAt = s.think($('[data-thinking]'), 420, 950);
      s.reveal($('.answer .mark'), pop, { duration: 420, delay: replyAt - 60, easing: EASE_SETTLE });
      start = replyAt + 80;
    }

    const streamed = s.stream($('[data-stream]')!, { delay: start, stagger: 16 });
    await s.wait(streamed - 160);

    const example = $('.example');
    if (example) {
      s.reveal(example, rise, { duration: 560 });
      const query = $('.query')!;
      s.reveal(query, fadeUp, { duration: 420, delay: 120 });
      await s.wait(260);
      const typed = $('[data-type]')!;
      await s.typeText(typed, typed.dataset.type!, 30);
      await s.wait(160);
      root.querySelectorAll('.person').forEach((row, i) => {
        s.reveal(row, rise, { duration: 560, delay: i * 130 });
        s.reveal(row.querySelector('.via'), pop, { duration: 440, delay: 260 + i * 130, easing: EASE_SETTLE });
      });
      await s.wait(420);
    }

    const next = $('.next');
    if (next) {
      s.reveal(next, fadeUp, { duration: 420 });
      next.querySelectorAll('.chip').forEach((chip, i) => s.reveal(chip, fadeUp, { duration: 380, delay: 120 + i * 80 }));
    }
  };

  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('[data-item]')];
    const threads = [...root.querySelectorAll<HTMLElement>('[data-thread]')];
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const card = root.querySelector<HTMLElement>('.card')!;
    const mobile = window.matchMedia('(max-width: 1023px)');
    const animate = !reducedMotion() && threads.every((t) => t.dataset.motion === 'pending');
    let active: number | null = Number(root.dataset.active);

    // One sequence per answer: the chat thread (desktop) and the accordion panel (mobile).
    const seqs = new Map<HTMLElement, Seq>();
    root.querySelectorAll<HTMLElement>('[data-answer]').forEach((el) => {
      const s = createSequence(el);
      seqs.set(el, s);
      if (animate) {
        s.reset();
        el.dataset.motion = 'ready';
      }
    });

    const answerFor = (number: number) =>
      mobile.matches
        ? root.querySelector<HTMLElement>(`[data-item="${number}"] [data-answer]`)
        : root.querySelector<HTMLElement>(`[data-thread="${number}"]`);

    const play = (number: number | null) => {
      if (!animate || number === null) return;
      const el = answerFor(number);
      if (el) playAnswer(el, seqs.get(el)!).catch(() => {});
    };

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const groups = [...root.querySelectorAll<HTMLElement>('[data-group]')];
    const groupOf = (number: number) =>
      groups.findIndex((g) => g.querySelector(`[data-item="${number}"]`));
    let activeGroup = Math.max(0, groupOf(active ?? 0));

    const renderGroups = () => {
      tabs.forEach((tab, i) => {
        const on = i === activeGroup;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      groups.forEach((g, i) => (g.hidden = i !== activeGroup));
    };

    const render = () => {
      items.forEach((item) => {
        const number = Number(item.dataset.item);
        const on = number === active;
        item.classList.toggle('is-active', on);
        item.querySelector('button.q')?.setAttribute('aria-expanded', String(on));
      });
      threads.forEach((thread) => (thread.hidden = Number(thread.dataset.thread) !== active));
      if (active !== null) count.textContent = String(active).padStart(2, '0');
    };

    // Opens a question: on small screens the list is an accordion, so a second tap closes it.
    const select = (number: number) => {
      active = mobile.matches && active === number ? null : number;
      // An "Ask next" chip can point into another topic; bring its tab along.
      const group = groupOf(number);
      if (group >= 0 && group !== activeGroup) {
        activeGroup = group;
        renderGroups();
      }
      const from = card.offsetHeight;
      render();
      // Ease the chat card to the new answer's height instead of snapping.
      if (animate && !mobile.matches) {
        const to = card.offsetHeight;
        if (from !== to) {
          card.animate([{ height: `${from}px` }, { height: `${to}px` }], {
            duration: 420,
            easing: 'cubic-bezier(0.65, 0, 0.35, 1)',
          });
        }
      }
      play(active);
    };

    root.addEventListener('click', (event) => {
      const tab = (event.target as HTMLElement).closest<HTMLElement>('[data-tab]');
      if (tab) {
        const index = Number(tab.dataset.tab);
        if (index === activeGroup) return;
        activeGroup = index;
        renderGroups();
        // A new topic opens its first answer, so the chat card always matches the list.
        const first = groups[index].querySelector<HTMLElement>('[data-ask]');
        if (first && !mobile.matches) select(Number(first.dataset.ask));
        return;
      }
      const target = (event.target as HTMLElement).closest<HTMLElement>('[data-ask]');
      if (target) select(Number(target.dataset.ask));
    });

    // Arrow keys move between tabs, as in any tab list.
    root.querySelector('[role="tablist"]')?.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (key !== 'ArrowRight' && key !== 'ArrowLeft') return;
      event.preventDefault();
      const next = (activeGroup + (key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
      tabs[next].focus();
      tabs[next].click();
    });

    root.classList.add('has-tabs');
    renderGroups();

    // Switching layouts shows answers finished rather than half-built.
    mobile.addEventListener('change', () => {
      if (!mobile.matches && active === null) {
        active = Number(threads[0]?.dataset.thread);
        render();
      }
      seqs.forEach((s) => s.finish());
    });

    // The opening answer builds when it first scrolls into view.
    if (animate && active !== null) {
      const first = answerFor(active);
      if (first) onFirstView(first, () => play(active), 0.3);
    }
  });
</script>

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: var(--section-y);
  }

  /* Stacked: the chat card on top, the topic tabs below it, then that topic's questions. */
  .layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .questions {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  /* Topic tabs, styled like the AI Tools tabs: soft white pills, the active one a blue gradient
     pill inside a thin white ring. */
  .tabs {
    display: none;
    justify-content: center;
    gap: 10px;
  }

  .tab {
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: var(--shadow-tab);
    font-size: 15px;
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
    transition: background-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .tab-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 18px;
    border-radius: var(--r-md);
  }

  .tab:not(.is-active):hover {
    background: var(--surface);
    transform: translateY(-1px);
  }

  .tab.is-active {
    padding: 2px;
    font-weight: 600;
    color: #fff;
  }

  .tab.is-active .tab-inner {
    height: 40px;
    background: var(--gradient-blue);
    box-shadow: var(--shadow-blue-inset);
  }

  .tab:focus-visible {
    outline: 2px solid var(--blue-600);
    outline-offset: 2px;
  }

  /* With scripting the tabs replace the group labels, and only one group shows at a time. */
  .has-tabs .tabs {
    display: flex;
  }

  .has-tabs .group-label {
    display: none;
  }

  .group[hidden] {
    display: none;
  }

  .group {
    width: 100%;
  }

  .group ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .group-label {
    padding: 0 14px 8px;
    text-align: center;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .q {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 14px;
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.55);
    text-align: left;
    white-space: nowrap;
    transition: background-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .num {
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .label {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-body);
    transition: color var(--dur) var(--ease);
  }

  .arrow {
    display: none;
    transition: transform var(--dur) var(--ease);
  }

  button.q:hover {
    background: rgba(255, 255, 255, 0.72);
  }

  button.q:hover .label {
    color: var(--text-primary);
  }

  .item.is-active .q {
    background: var(--surface);
    box-shadow: var(--shadow-tab), 0 8px 18px -10px rgba(36, 55, 85, 0.3);
  }

  .item.is-active .num {
    color: var(--blue-600);
  }

  .item.is-active .label {
    color: var(--text-primary);
  }

  .inline {
    display: none;
  }

  .contact {
    padding-top: 4px;
    font-size: 14px;
    color: var(--text-body);
  }

  .contact-link {
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Answer card */
  .card {
    display: flex;
    order: -1;
    width: 640px;
    max-width: 100%;
    flex-direction: column;
    gap: 0; /* the active thread carries the spacing so it can collapse to nothing */
    padding: 16px 22px 22px;
    overflow: hidden; /* clips content while the card eases between answer heights */
    border-radius: var(--r-xl);
    background: var(--surface);
    filter: drop-shadow(0 24px 24px rgba(51, 46, 115, 0.14));
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 4px;
  }

  .mark {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--r-sm);
    background: #fafafa;
    box-shadow: var(--shadow-mark), var(--shadow-mark-inset);
  }

  .card-title {
    flex: 1;
    font-size: 15px;
    font-weight: 600;
  }

  .card-count {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .thread {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 18px; /* space above the input, kept even when the thread is collapsed */
  }

  .thread > :first-child {
    margin-top: 18px;
  }

  /* While an answer builds, the thread grows from zero height; overflow stays clipped. */
  .thread.is-growing {
    overflow: hidden;
  }

  .thread[hidden] {
    display: none;
  }

  .you {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
  }

  .bubble {
    padding: 9px 14px;
    border-radius: var(--r-md);
    background: var(--text-primary);
    font-size: 14px;
    font-weight: 500;
    color: #fff;
  }

  .you-photo {
    width: 32px;
    height: 32px;
    border-radius: 50%;
  }

  .answer {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  /* The thinking bot overlays the start of the answer row (where the mark appears). */
  .answer :global(.thinking-slot) {
    position: absolute;
    top: 0;
    left: 0;
  }

  .answer > :global(.reply) {
    flex: 1;
    min-width: 0;
  }

  .ask {
    margin-top: auto; /* stays on the card's bottom edge as its height changes */
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 6px 6px 14px;
    border-radius: var(--r-md);
    background: var(--bg-soft);
    font-size: 14px;
    color: var(--text-placeholder);
  }

  .ask-field {
    position: relative;
    flex: 1;
    min-width: 0;
    white-space: nowrap;
  }

  /* While a question is being typed the placeholder gives way to the typed text and a caret. */
  .ask-placeholder {
    transition: opacity 200ms var(--ease);
  }

  .ask-typed {
    position: absolute;
    left: 0;
    color: var(--text-primary);
  }

  .ask-caret {
    display: none;
    width: 1.2px;
    height: 16px;
    margin-left: 1px;
    vertical-align: -3px;
    border-radius: 1px;
    background: var(--blue-900);
  }

  .card.is-typing .ask-placeholder {
    opacity: 0;
  }

  .card.is-typing .ask-caret {
    display: inline-block;
    position: absolute;
    left: var(--caret-x, 0);
  }

  /* On phones the three tabs share the row equally instead of pushing the page sideways. */
  @media (max-width: 767px) {
    .tabs {
      align-self: stretch;
    }

    .tabs {
      gap: 6px;
    }

    .tab {
      flex: 1;
      min-width: 0;
      font-size: 13px;
      white-space: normal;
      text-align: center;
      line-height: 1.2;
    }

    .tab-inner {
      height: 48px;
      padding: 0 8px;
    }

    .tab.is-active .tab-inner {
      height: 44px;
    }
  }

  /* Accordion on smaller screens */
  @media (max-width: 1023px) {
    .layout {
      flex-direction: column;
    }

    .questions {
      align-items: stretch;
    }

    .card {
      display: none;
    }

    .group ul {
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 4px;
    }

    .item {
      align-items: stretch;
    }

    .q {
      height: auto;
      padding: 11px 12px 11px 14px;
      background: transparent;
      white-space: normal;
    }

    .num {
      width: 20px;
    }

    .label {
      flex: 1;
      font-size: 15px;
    }

    .item.is-active .q {
      box-shadow: 0 2px 4px rgba(36, 55, 85, 0.07);
    }

    .contact {
      padding-inline: 14px;
    }

    button.q .arrow {
      display: block;
      opacity: 0.45;
    }

    .item.is-active .arrow {
      opacity: 1;
      transform: rotate(90deg);
    }

    .inline {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 350ms var(--ease);
    }

    .item.is-active .inline {
      grid-template-rows: 1fr;
    }

    .inline-inner {
      min-height: 0;
      overflow: hidden;
    }

    .item.is-active .inline-inner {
      padding: 12px 4px 8px;
    }
  }
</style>
