---
import arrowUp from '../assets/icons/arrow-up.svg?url';

interface Props {
  label?: string;
  type?: 'button' | 'submit';
}

const { label = 'Send', type = 'button' } = Astro.props;
---

<button class="send" type={type} aria-label={label}>
  <img src={arrowUp} alt="" width="10" height="14" />
</button>

<style>
  .send {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--r-md);
    background: var(--gradient-blue);
    box-shadow: var(--shadow-blue-inset);
    transition: filter var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .send:hover {
    filter: brightness(1.08);
  }

  .send:active {
    transform: scale(0.96);
  }
</style>
