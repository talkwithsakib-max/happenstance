---
import { Image } from 'astro:assets';
import { testimonials, initialTestimonial } from '../data/testimonials';
import linkShort from '../assets/testimonials/link-short.svg?url';
import linkShortR from '../assets/testimonials/link-short-r.svg?url';
import linkLong from '../assets/testimonials/link-long.svg?url';

const count = testimonials.length;
const slotFor = (i: number) => {
  // Offset from the centred card, wrapped into -2..2.
  let offset = (i - initialTestimonial + count) % count;
  if (offset > count / 2) offset -= count;
  return offset;
};
---

<section class="testimonials" aria-roledescription="carousel" aria-label="What people say about Happenstance">
  <div class="viewport">
    <div class="stage" data-carousel data-fit="1440" data-active={initialTestimonial}>
      <img class="link link-l2" src={linkShort} alt="" />
      <img class="link link-l1" src={linkLong} alt="" />
      <img class="link link-r1" src={linkLong} alt="" />
      <img class="link link-r2" src={linkShortR} alt="" />

      {
        testimonials.map((t, i) => (
          <article
            class="card"
            data-card={i}
            data-slot={slotFor(i)}
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${count}: ${t.name}`}
            aria-hidden={slotFor(i) === 0 ? 'false' : 'true'}
          >
            <button class="card-hit" type="button" data-goto={i} tabindex="-1" aria-label={`Show ${t.name}`} />
            <div class="photo">
              <Image src={t.photo} alt={t.name} widths={[240, 400, 744]} sizes="372px" loading="lazy" />
            </div>
            <div class="copy">
              {t.headline && (
                <h2 class="headline">
                  {t.headline.lead} <span class="muted">{t.headline.accent}</span>
                </h2>
              )}
              <div class="testimonial">
                {t.quote && <blockquote class="quote">{t.quote}</blockquote>}
                <div class="author">
                  <span class="chip">{t.name}</span>
                  {t.role && <span class="chip">{t.role}</span>}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="pager" role="tablist" aria-label="Choose a testimonial">
    {
      testimonials.map((t, i) => (
        <button
          class:list={['dot', { 'is-active': i === initialTestimonial }]}
          type="button"
          role="tab"
          data-goto={i}
          aria-selected={i === initialTestimonial ? 'true' : 'false'}
          aria-label={t.name}
        />
      ))
    }
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.testimonials');
  const stage = root?.querySelector<HTMLElement>('[data-carousel]');

  if (root && stage) {
    const cards = [...stage.querySelectorAll<HTMLElement>('[data-card]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dot')];
    const count = cards.length;
    let active = Number(stage.dataset.active) || 0;

    const render = () => {
      cards.forEach((card, i) => {
        let offset = (i - active + count) % count;
        if (offset > count / 2) offset -= count;
        card.dataset.slot = String(offset);
        card.setAttribute('aria-hidden', offset === 0 ? 'false' : 'true');
        card.querySelector<HTMLElement>('.card-hit')!.tabIndex = -1;
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === active);
        dot.setAttribute('aria-selected', String(i === active));
      });
    };

    const go = (index: number) => {
      active = (index + count) % count;
      render();
    };

    root.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLElement>('[data-goto]');
      if (target) go(Number(target.dataset.goto));
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') go(active + 1);
      else if (event.key === 'ArrowLeft') go(active - 1);
      else return;
      event.preventDefault();
      dots[active].focus();
    });

    // Swipe on touch screens.
    let startX = 0;
    stage.addEventListener('pointerdown', (event) => (startX = event.clientX));
    stage.addEventListener('pointerup', (event) => {
      const delta = event.clientX - startX;
      if (Math.abs(delta) > 40) go(active + (delta < 0 ? 1 : -1));
    });

    render();
  }
</script>

<style>
  .testimonials {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding-block: 52px;
    overflow: hidden;
  }

  .viewport {
    width: 100%;
  }

  .stage {
    position: relative;
    width: 1440px;
    height: 620px;
    margin-inline: auto;
    zoom: var(--fit, 1);
    touch-action: pan-y;
  }

  .link {
    position: absolute;
    width: 62px;
    pointer-events: none;
  }

  .link-l2 {
    left: 152px;
    top: 278px;
    height: 64px;
  }

  .link-l1 {
    left: 286px;
    top: 268px;
    height: 84px;
  }

  .link-r1 {
    left: 1092px;
    top: 268px;
    height: 84px;
  }

  .link-r2 {
    left: 1226px;
    top: 278px;
    height: 64px;
  }

  /* Cards move between five slots: -2, -1, 0 (centre), 1, 2. */
  .card {
    position: absolute;
    overflow: hidden;
    background: var(--surface);
    transition:
      left 600ms var(--ease),
      top 600ms var(--ease),
      width 600ms var(--ease),
      height 600ms var(--ease),
      border-radius 600ms var(--ease),
      box-shadow 600ms var(--ease);
  }

  .card[data-slot='-2'],
  .card[data-slot='2'] {
    top: 204px;
    width: 78px;
    height: 212px;
    border-radius: var(--r-md);
    box-shadow: var(--shadow-panel);
  }

  .card[data-slot='-2'] {
    left: 92px;
  }

  .card[data-slot='2'] {
    left: 1270px;
  }

  .card[data-slot='-1'],
  .card[data-slot='1'] {
    top: 132px;
    width: 108px;
    height: 356px;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-panel);
  }

  .card[data-slot='-1'] {
    left: 196px;
  }

  .card[data-slot='1'] {
    left: 1136px;
  }

  .card[data-slot='0'] {
    z-index: 2;
    left: 330px;
    top: 50px;
    width: 780px;
    height: 520px;
    border-radius: var(--r-xl);
    box-shadow: 0 24px 48px -12px rgba(51, 46, 115, 0.14);
  }

  .card-hit {
    position: absolute;
    inset: 0;
    z-index: 3;
    cursor: pointer;
  }

  .card[data-slot='0'] .card-hit {
    display: none;
  }

  .card:not([data-slot='0']):hover {
    box-shadow: 0 28px 32px rgba(51, 46, 115, 0.2);
  }

  .card:not([data-slot='0']):hover .photo img {
    filter: grayscale(0);
  }

  .photo {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    bottom: 12px;
    overflow: hidden;
    border: 1px solid var(--border-faint);
    border-radius: var(--r-sm);
    transition: all 600ms var(--ease);
  }

  .card[data-slot='0'] .photo {
    top: 16px;
    left: 392px;
    right: 16px;
    bottom: 16px;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 400ms var(--ease);
  }

  .copy {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 376px;
    height: 488px;
    padding: 24px 20px 12px 28px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 300ms var(--ease), visibility 0s 300ms;
  }

  .card[data-slot='0'] .copy {
    opacity: 1;
    visibility: visible;
    transition: opacity 400ms 250ms var(--ease);
  }

  .headline {
    font-size: 34px;
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -1.02px;
  }

  .testimonial {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: auto;
  }

  .quote {
    font-family: var(--font-serif);
    /* Figma renders Newsreader with automatic optical sizing. */
    font-optical-sizing: auto;
    font-variation-settings: normal;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.6px;
    color: #0f1729;
  }

  .author {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .chip {
    padding: 5px 9px;
    border-radius: var(--r-xs);
    background: var(--bg-subtle);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.065px;
    color: var(--text-strong);
  }

  /* Pager */
  .pager {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: var(--surface);
    transition: width 300ms var(--ease), background-color var(--dur) var(--ease);
  }

  .dot::after {
    content: '';
    position: absolute;
    inset: -8px -3px;
  }

  .dot:not(.is-active):hover {
    background: #d5d8de;
  }

  .dot.is-active {
    width: 28px;
    border-radius: 40px 40px 40px 6px;
    background: var(--gradient-blue);
    box-shadow: var(--shadow-blue-inset);
  }

  /* Below desktop: show the centred card only, stacked, so text stays legible. */
  @media (max-width: 1023px) {
    .viewport {
      padding-inline: var(--gutter);
    }

    .stage {
      zoom: 1;
      width: 100%;
      max-width: 560px;
      height: auto;
    }

    .link,
    .card:not([data-slot='0']) {
      display: none;
    }

    .card[data-slot='0'] {
      position: relative;
      inset: auto;
      display: flex;
      flex-direction: column;
      width: 100%;
      height: auto;
    }

    .card[data-slot='0'] .photo {
      position: relative;
      inset: auto;
      margin: 12px 12px 0;
      aspect-ratio: 372 / 420;
    }

    .copy {
      position: relative;
      inset: auto;
      width: auto;
      height: auto;
      gap: 32px;
      padding: 24px 20px 20px;
    }

    .headline {
      font-size: 28px;
    }

    .quote {
      font-size: 24px;
    }
  }
</style>
