---
import { Image } from 'astro:assets';
import { testimonials, initialTestimonial } from '../data/testimonials';
import linkShort from '../assets/testimonials/link-short.svg?url';
import linkShortR from '../assets/testimonials/link-short-r.svg?url';
import linkLong from '../assets/testimonials/link-long.svg?url';

const count = testimonials.length;
const slotFor = (i: number) => {
  // Offset from the centred card, wrapped into -2..2.
  let offset = (i - initialTestimonial + count) % count;
  if (offset > count / 2) offset -= count;
  return offset;
};
---

<section class="testimonials" aria-roledescription="carousel" aria-label="What people say about Happenstance" data-motion>
  <div class="viewport m-hide">
    <div class="stage" data-carousel data-fit="1440" data-active={initialTestimonial}>
      <img class="link link-l2" src={linkShort} alt="" />
      <img class="link link-l1" src={linkLong} alt="" />
      <img class="link link-r1" src={linkLong} alt="" />
      <img class="link link-r2" src={linkShortR} alt="" />

      {
        testimonials.map((t, i) => (
          <article
            class="card"
            data-card={i}
            data-slot={slotFor(i)}
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${count}: ${t.name}`}
            aria-hidden={slotFor(i) === 0 ? 'false' : 'true'}
          >
            <button class="card-hit" type="button" data-goto={i} tabindex="-1" aria-label={`Show ${t.name}`} />
            <div class="photo">
              <Image src={t.photo} alt={t.name} widths={[240, 400, 744]} sizes="372px" loading="lazy" />
            </div>
            <div class="copy">
              {t.headline && (
                <h2 class="headline">
                  {t.headline.lead} <span class="muted">{t.headline.accent}</span>
                </h2>
              )}
              <div class="testimonial">
                {t.quote && <blockquote class="quote">{t.quote}</blockquote>}
                <div class="author">
                  <span class="chip">{t.name}</span>
                  {t.role && <span class="chip">{t.role}</span>}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="pager m-hide" role="tablist" aria-label="Choose a testimonial">
    {
      testimonials.map((t, i) => (
        <button
          class:list={['dot', { 'is-active': i === initialTestimonial }]}
          type="button"
          role="tab"
          data-goto={i}
          aria-selected={i === initialTestimonial ? 'true' : 'false'}
          aria-label={t.name}
        >
          <span class="dot-fill" />
        </button>
      ))
    }
  </div>
  <p class="sample-note">Apart from Garry Tan’s, these testimonials are illustrative samples.</p>

  <script is:inline>
    // Lets the carousel fade in and auto-advance only when motion is allowed.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.currentScript.parentElement.dataset.motion = 'pending';
  </script>
</section>

<script>
  import { createSequence, onFirstView, reducedMotion, EASE_OUT } from '../scripts/motion';

  // How long each testimonial stays up before the next one (Calendly uses about six seconds).
  const INTERVAL_MS = 6000;

  const root = document.querySelector<HTMLElement>('.testimonials');
  const stage = root?.querySelector<HTMLElement>('[data-carousel]');

  if (root && stage) {
    const cards = [...stage.querySelectorAll<HTMLElement>('[data-card]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dot')];
    const count = cards.length;
    const animate = !reducedMotion() && root.dataset.motion === 'pending';
    let active = Number(stage.dataset.active) || 0;
    let started = false;
    let timer: Animation | null = null;
    const holds = new Set<string>();

    const offsetOf = (i: number) => {
      let offset = (i - active + count) % count;
      if (offset > count / 2) offset -= count;
      return offset;
    };

    // A card that wraps from one end to the other leaves off its edge and re-enters from the
    // opposite edge, instead of sliding across the whole stage behind the others.
    const wrapCard = (card: HTMLElement, to: number) => {
      const dir = to > 0 ? 1 : -1;
      const out = card.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: `translateX(${-dir * 48}px)` }], {
        duration: 260,
        easing: 'ease-in',
        fill: 'forwards',
      });
      out.finished.then(() => {
        card.classList.add('is-wrapping');
        card.dataset.slot = String(to);
        void card.offsetWidth; // jump to the new slot without the slide transition
        card.classList.remove('is-wrapping');
        out.cancel();
        card.animate([{ opacity: 0, transform: `translateX(${dir * 48}px)` }, { opacity: 1, transform: 'none' }], {
          duration: 520,
          delay: 160,
          easing: EASE_OUT,
          fill: 'backwards',
        });
      }, () => {});
    };

    const render = (animateWrap = false) => {
      cards.forEach((card, i) => {
        const to = offsetOf(i);
        const from = Number(card.dataset.slot);
        if (animateWrap && Math.abs(to - from) > 2) wrapCard(card, to);
        else card.dataset.slot = String(to);
        card.setAttribute('aria-hidden', to === 0 ? 'false' : 'true');
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === active);
        dot.setAttribute('aria-selected', String(i === active));
      });
    };

    // The active pager pill fills up as a visible timer; when it is full the next card comes in.
    const startTimer = () => {
      timer?.cancel();
      timer = null;
      if (!animate || !started) return;
      const fill = dots[active].querySelector<HTMLElement>('.dot-fill')!;
      timer = fill.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], {
        duration: INTERVAL_MS,
        easing: 'linear',
        fill: 'forwards',
      });
      timer.onfinish = () => go(active + 1);
      if (holds.size) timer.pause();
    };

    const hold = (reason: string, on: boolean) => {
      if (on) holds.add(reason);
      else holds.delete(reason);
      if (!timer) return;
      if (holds.size) timer.pause();
      else if (timer.playState === 'paused') timer.play();
    };

    function go(index: number) {
      active = (index + count) % count;
      render(true);
      startTimer();
    }

    root.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLElement>('[data-goto]');
      if (target) go(Number(target.dataset.goto));
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') go(active + 1);
      else if (event.key === 'ArrowLeft') go(active - 1);
      else return;
      event.preventDefault();
      dots[active].focus();
    });

    // Swipe on touch screens.
    let startX = 0;
    stage.addEventListener('pointerdown', (event) => (startX = event.clientX));
    stage.addEventListener('pointerup', (event) => {
      const delta = event.clientX - startX;
      if (Math.abs(delta) > 40) go(active + (delta < 0 ? 1 : -1));
    });

    render();

    if (animate) {
      // Pause while someone is reading or using the carousel, and while it is off screen.
      root.addEventListener('pointerenter', () => hold('hover', true));
      root.addEventListener('pointerleave', () => hold('hover', false));
      root.addEventListener('focusin', () => hold('focus', true));
      root.addEventListener('focusout', (e) => {
        if (!root.contains(e.relatedTarget as Node)) hold('focus', false);
      });
      new IntersectionObserver(([entry]) => hold('offscreen', !entry.isIntersecting)).observe(root);

      // Entrance: the stage and pager fade up when the section first comes into view.
      const seq = createSequence(root);
      seq.reset();
      root.dataset.motion = 'ready';
      onFirstView(root, () => {
        root.dataset.motion = 'playing';
        seq.reveal(root.querySelector('.viewport'), [{ opacity: 0, transform: 'translateY(18px) scale(0.985)' }, { opacity: 1, transform: 'none' }], {
          duration: 900,
        });
        seq.reveal(root.querySelector('.pager'), [{ opacity: 0 }, { opacity: 1 }], { duration: 600, delay: 450 });
        started = true;
        startTimer();
      }, 0.3);
    }
  }
</script>

<style>
  .testimonials {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding-block: 52px;
    overflow: hidden;
  }

  .viewport {
    width: 100%;
  }

  .stage {
    position: relative;
    width: 1440px;
    height: 620px;
    margin-inline: auto;
    zoom: var(--fit, 1);
    touch-action: pan-y;
  }

  .link {
    position: absolute;
    width: 62px;
    pointer-events: none;
  }

  .link-l2 {
    left: 152px;
    top: 278px;
    height: 64px;
  }

  .link-l1 {
    left: 286px;
    top: 268px;
    height: 84px;
  }

  .link-r1 {
    left: 1092px;
    top: 268px;
    height: 84px;
  }

  .link-r2 {
    left: 1226px;
    top: 278px;
    height: 64px;
  }

  /* Cards move between five slots: -2, -1, 0 (centre), 1, 2. */
  .card {
    position: absolute;
    overflow: hidden;
    background: var(--surface);
    /* Calendly-style pacing: one smooth ~0.7s move for every card. */
    --move: 700ms cubic-bezier(0.65, 0, 0.35, 1);
    transition:
      left var(--move),
      top var(--move),
      width var(--move),
      height var(--move),
      border-radius var(--move),
      box-shadow var(--move);
  }

  /* A wrapping card jumps to its new slot while it is invisible. */
  .card.is-wrapping,
  .card.is-wrapping .photo {
    transition: none;
  }

  .card[data-slot='-2'],
  .card[data-slot='2'] {
    top: 204px;
    width: 78px;
    height: 212px;
    border-radius: var(--r-md);
    box-shadow: var(--shadow-panel);
  }

  .card[data-slot='-2'] {
    left: 92px;
  }

  .card[data-slot='2'] {
    left: 1270px;
  }

  .card[data-slot='-1'],
  .card[data-slot='1'] {
    top: 132px;
    width: 108px;
    height: 356px;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-panel);
  }

  .card[data-slot='-1'] {
    left: 196px;
  }

  .card[data-slot='1'] {
    left: 1136px;
  }

  .card[data-slot='0'] {
    z-index: 2;
    left: 330px;
    top: 50px;
    width: 780px;
    height: 520px;
    border-radius: var(--r-xl);
    box-shadow: 0 24px 48px -12px rgba(51, 46, 115, 0.14);
  }

  .card-hit {
    position: absolute;
    inset: 0;
    z-index: 3;
    cursor: pointer;
  }

  .card[data-slot='0'] .card-hit {
    display: none;
  }

  .card:not([data-slot='0']):hover {
    box-shadow: 0 28px 32px rgba(51, 46, 115, 0.2);
  }

  .photo {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    bottom: 12px;
    overflow: hidden;
    border-radius: var(--r-sm);
    transition: all 700ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .card[data-slot='0'] .photo {
    top: 16px;
    left: 392px;
    right: 16px;
    bottom: 16px;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Portraits stay black and white in every state, as in Figma. */
    filter: grayscale(1);
  }

  .copy {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 376px;
    height: 488px;
    padding: 24px 20px 12px 28px;
    opacity: 0;
    visibility: hidden;
    /* The quote leaves first, before the cards move… */
    transition: opacity 160ms ease-in, visibility 0s 160ms;
  }

  .card[data-slot='0'] .copy {
    opacity: 1;
    visibility: visible;
    /* …and the new one arrives once the centre card has settled. */
    transition: opacity 420ms 520ms var(--ease);
  }

  .headline {
    font-size: 34px;
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -1.02px;
  }

  .testimonial {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: auto;
  }

  .quote {
    font-family: var(--font-serif);
    /* Figma renders Newsreader with automatic optical sizing. */
    font-optical-sizing: auto;
    font-variation-settings: normal;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.6px;
    color: #0f1729;
  }

  .author {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .chip {
    padding: 5px 9px;
    border-radius: var(--r-xs);
    background: var(--bg-subtle);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.065px;
    color: var(--text-strong);
  }

  .sample-note {
    margin-top: -28px;
    font-size: 12px;
    color: var(--text-caption);
    text-align: center;
  }

  /* Pager: same indicator as the Network showcase (minus its pause button). */
  .pager {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 14px;
    border-radius: var(--r-sm);
    background: var(--divider);
  }

  .dot {
    position: relative;
    width: 5px;
    height: 5px;
    overflow: hidden;
    border-radius: 2px;
    background: #a1a6b0;
    transition: width 300ms var(--ease), background-color var(--dur) var(--ease);
  }

  .dot::after {
    content: '';
    position: absolute;
    inset: -8px -3px;
  }

  .dot:not(.is-active):hover {
    background: var(--text-primary);
  }

  .dot.is-active {
    width: 52px;
    height: 4px;
    background: #d5d8de;
  }

  /* The dark fill doubles as the auto-advance timer (it grows from left to right). Without
     motion it simply stays full. */
  .dot-fill {
    position: absolute;
    inset: 0;
    border-radius: 2px;
    background: var(--text-primary);
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }

  .dot.is-active .dot-fill {
    transform: scaleX(1);
  }

  .testimonials[data-motion='ready'] .dot.is-active .dot-fill,
  .testimonials[data-motion='playing'] .dot.is-active .dot-fill {
    transform: scaleX(0);
  }

  /* Below desktop: show the centred card only, stacked, so text stays legible. */
  @media (max-width: 1023px) {
    .viewport {
      padding-inline: var(--gutter);
    }

    .stage {
      zoom: 1;
      width: 100%;
      max-width: 560px;
      height: auto;
    }

    .link,
    .card:not([data-slot='0']) {
      display: none;
    }

    .card[data-slot='0'] {
      position: relative;
      inset: auto;
      display: flex;
      flex-direction: column;
      width: 100%;
      height: auto;
    }

    .card[data-slot='0'] .photo {
      position: relative;
      inset: auto;
      margin: 12px 12px 0;
      aspect-ratio: 372 / 420;
    }

    .copy {
      position: relative;
      inset: auto;
      width: auto;
      height: auto;
      gap: 32px;
      padding: 24px 20px 20px;
    }

    .headline {
      font-size: 28px;
    }

    .quote {
      font-size: 24px;
    }
  }
</style>
