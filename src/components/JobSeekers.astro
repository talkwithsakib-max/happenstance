---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import FeatureLabel from './FeatureLabel.astro';
import ThinkingBot from './ThinkingBot.astro';

import search from '../assets/icons/search.svg?url';
import sparkle from '../assets/icons/sparkle.svg?url';

import justSayBg from '../assets/jobs/just-say/bg.png';
import justSayGrain from '../assets/jobs/just-say/grain.png';
import logoAnthropic from '../assets/jobs/just-say/logo-anthropic.svg?url';
import logoNotion from '../assets/jobs/just-say/logo-notion.svg?url';
import logoRamp from '../assets/jobs/just-say/logo-ramp.svg?url';

import referredBg from '../assets/jobs/get-referred/bg.png';
import referredGrain from '../assets/jobs/get-referred/grain.png';
import referredYou from '../assets/jobs/get-referred/you.png';
import referredIshan from '../assets/jobs/get-referred/ishan.png';
import referredOmar from '../assets/jobs/get-referred/omar.png';
import link1 from '../assets/jobs/get-referred/link-1.svg?url';
import link2 from '../assets/jobs/get-referred/link-2.svg?url';
import sendArrow from '../assets/jobs/get-referred/arrow.svg?url';

import knowBg from '../assets/jobs/who-you-know/bg.png';
import knowGrain from '../assets/jobs/who-you-know/grain.png';
import jack from '../assets/jobs/who-you-know/jack-ng.png';
import alex from '../assets/jobs/who-you-know/alex.png';
import kevin from '../assets/jobs/who-you-know/kevin-wang.png';
import ishan from '../assets/jobs/who-you-know/ishan.png';
import olivia from '../assets/jobs/who-you-know/olivia-yao.png';
import drew from '../assets/jobs/who-you-know/drew.png';

import interviewBg from '../assets/jobs/interview/bg.png';
import interviewGrain from '../assets/jobs/interview/grain.png';
import interviewOmar from '../assets/jobs/interview/omar.png';
import calendar from '../assets/jobs/interview/calendar.svg?url';

const jobs = [
  { title: 'Applied AI Engineer, Anthropic', logo: logoAnthropic, paths: '4 warm paths', top: true },
  { title: 'Staff Engineer, Notion', logo: logoNotion, paths: '1 warm path' },
  { title: 'Senior PM, Ramp', logo: logoRamp, paths: '2 warm paths' },
];

const people = [
  { name: 'Jack Ng', detail: 'Product Manager at Meta', photo: jack, via: 'via Alex', viaPhoto: alex },
  { name: 'Kevin Wang', detail: 'Software Engineer at Meta', photo: kevin, via: 'via Ishan', viaPhoto: ishan },
  { name: 'Olivia Yao', detail: 'Staff Data Scientist at Meta', photo: olivia, via: 'via Drew', viaPhoto: drew },
];

// Diagonal light sheen that sits over each watercolor, per card (from Figma).
const sheen = (deg: number, a: number[], b: number[]) =>
  `linear-gradient(${deg}deg, rgba(255,255,255,0) 21.3%, rgba(255,255,255,0) ${a[0]}%, rgba(255,255,255,.315) ${a[1]}%, rgba(255,255,255,.45) ${a[2]}%, rgba(255,255,255,.225) ${a[3]}%, rgba(255,255,255,0) ${a[4]}%), ` +
  `linear-gradient(${deg}deg, rgba(255,255,255,0) 21.3%, rgba(255,255,255,0) ${b[0]}%, rgba(255,255,255,.42) ${b[1]}%, rgba(255,255,255,.6) ${b[2]}%, rgba(255,255,255,.3) ${b[3]}%, rgba(255,255,255,0) ${b[4]}%)`;
---

<section class="jobs container" aria-labelledby="jobs-title">
  <SectionHeading id="jobs-title" leadWidth={414}>
    <span class="muted">How job seekers use</span><br />Happenstance
    <Fragment slot="lead">
      A referral beats a hundred applications. Here’s what job seekers use Happenstance for day to day.
    </Fragment>
  </SectionHeading>

  <div class="bento">
    <article class="card card-wide">
      <div class="copy copy-wide">
        <FeatureLabel>Natural-language search</FeatureLabel>
        <h3 class="display">Just say what you’re looking for</h3>
        <p>
          You don’t have to spell out your background. Happenstance already knows where you’ve worked and who you know,
          so even a vague search comes back tailored to you.
        </p>
      </div>
      <div class="visual visual-wide" data-motion data-seq="just-say" role="img" aria-label="A search for “Looking for my next job in SF” returns three matching roles, each with warm paths">
        <div class="visual-bg" aria-hidden="true">
          <Image src={justSayBg} alt="" widths={[700, 1024]} sizes="700px" loading="lazy" />
          <div class="grain" style={`background-image:url(${justSayGrain.src});background-size:128px 128px;opacity:.35`}></div>
          <div class="sheen" style={`background-image:${sheen(142.5, [52.9, 55.9, 57.5, 58.6, 62.1], [37.4, 41.8, 44.3, 46, 51.1])}`}></div>
        </div>
        <ThinkingBot tone="pill" class="job-think" />
        <div class="stack stack-center gap-16">
          <p class="query m-hide" data-query>
            <img src={search} alt="" width="16" height="16" />
            <span data-type="“Looking for my next job in SF”">“Looking for my next job in SF”</span><span class="caret" aria-hidden="true"></span>
          </p>
          <div class="results m-hide" data-results>
            <p class="results-head m-hide"><img src={sparkle} alt="" width="10" height="10" />Matched to your background, in SF</p>
            {
              jobs.map((job) => (
                <div class:list={['job', 'm-hide', { top: job.top }]}>
                  <img class="job-logo" src={job.logo} alt="" width="28" height="28" />
                  <span class="job-title">{job.title}</span>
                  <span class="paths-pill m-hide">
                    <i class="dot" />
                    {job.paths}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </article>

    <div class="row">
      <article class="card card-tall">
        <div class="copy copy-top">
          <FeatureLabel>Referrals</FeatureLabel>
          <h3 class="display">Get referred, not rejected</h3>
        </div>
        <div class="visual visual-tall" data-motion data-seq="referred" role="img" aria-label="Happenstance finds Ishan Shah as the strongest mutual connection to Omar Faroque and drafts an intro message">
          <div class="visual-bg" aria-hidden="true">
            <Image src={referredBg} alt="" widths={[596, 1024]} sizes="596px" loading="lazy" />
            <div class="grain" style={`background-image:url(${referredGrain.src});background-size:128px 128px;opacity:.35`}></div>
            <div class="sheen" style={`background-image:${sheen(136.7, [53.4, 56.4, 58, 59.2, 62.6], [37.4, 41.8, 44.3, 46, 51.1])}`}></div>
          </div>
          <ThinkingBot tone="pill" class="job-think" />
          <div class="stack stack-center gap-32">
            <p class="query m-hide" data-query>
              <img src={search} alt="" width="16" height="16" />
              <span data-type="“Who can introduce me to Omar Faroque?”">“Who can introduce me to Omar Faroque?”</span><span class="caret" aria-hidden="true"></span>
            </p>
            <div class="chain-fit">
              <div class="chain" data-fit="404">
                <div class="node m-hide" data-node="you">
                  <span class="tile tile-tilt-r"><Image src={referredYou} alt="" width={60} height={60} densities={[1, 2]} loading="lazy" /></span>
                  <span class="node-name">You</span>
                  <span class="node-role">Job seeker</span>
                </div>
                <img class="link m-hide" data-link src={link1} alt="" width="56" height="104" />
                <div class="node m-hide" data-node="ishan">
                  <span class="tile tile-active"><Image src={referredIshan} alt="" width={60} height={60} densities={[1, 2]} loading="lazy" /></span>
                  <span class="node-name">Ishan Shah</span>
                  <span class="node-role">Strongest mutual</span>
                </div>
                <img class="link m-hide" data-link src={link2} alt="" width="56" height="104" />
                <div class="node m-hide" data-node="omar">
                  <span class="tile tile-tilt-l"><Image class="omar" src={referredOmar} alt="" width={120} loading="lazy" /></span>
                  <span class="node-name">Omar Faroque</span>
                  <span class="node-role">Meta</span>
                </div>
              </div>
            </div>
            <div class="draft m-hide" data-draft>
              <p class="draft-head m-hide"><img src={sparkle} alt="" width="10" height="10" />Drafted for you · ready to send</p>
              <p class="draft-body" data-stream>
                Ishan, I’m going after a role on Omar Faroque’s team at Meta, and a conversation with him first would make a
                real difference. An intro from you would carry far more weight than a cold application.
              </p>
              <div class="draft-actions m-hide">
                <span class="btn-edit">Edit</span>
                <span class="btn-send">Send intro <img src={sendArrow} alt="" width="14" height="14" /></span>
              </div>
            </div>
          </div>
        </div>
        <div class="copy copy-bottom">
          <p>
            A referral means a person reads your resume instead of a filter. Point it at the team you want, and it finds
            your warmest path in and drafts the ask.
          </p>
        </div>
      </article>

      <div class="stack-col">
        <article class="card card-half">
          <div class="copy copy-half">
            <FeatureLabel>Warm intros</FeatureLabel>
            <h3 class="display">See who you already know at the company</h3>
            <p>
              Happenstance searches everyone you’ve emailed, met, and worked alongside, plus your friends’ networks. Old
              classmates count, and so do the people who never became LinkedIn connections.
            </p>
          </div>
          <div class="visual visual-half visual-know" data-motion data-seq="know" role="img" aria-label="Search results show Jack Ng, Kevin Wang and Olivia Yao at Meta, each reachable through a mutual friend">
            <div class="visual-bg" aria-hidden="true">
              <Image src={knowBg} alt="" widths={[572, 1144]} sizes="572px" loading="lazy" />
              <div class="grain" style={`background-image:url(${knowGrain.src});opacity:.35`}></div>
              <div class="sheen" style={`background-image:${sheen(136.7, [54.6, 57.6, 59.2, 60.3, 63.8], [38.5, 43, 45.4, 47.1, 52.3])}`}></div>
            </div>
            <ThinkingBot tone="pill" class="job-think" />
            <div class="stack gap-8">
              <p class="query m-hide" data-query>
                <img src={search} alt="" width="16" height="16" />
                <span data-type="“Who do I know at Meta from my school?”">“Who do I know at Meta from my school?”</span><span class="caret" aria-hidden="true"></span>
              </p>
              {
                people.map((p) => (
                  <div class="person m-hide">
                    <Image class="person-photo" src={p.photo} alt="" width={40} height={40} densities={[1, 2]} loading="lazy" />
                    <span class="person-info">
                      <span class="person-name">{p.name}</span>
                      <span class="person-detail">{p.detail}</span>
                    </span>
                    <span class="via m-hide">
                      <Image src={p.viaPhoto} alt="" width={20} height={20} densities={[1, 2]} loading="lazy" />
                      {p.via}
                    </span>
                  </div>
                ))
              }
            </div>
            <div class="fade" aria-hidden="true"></div>
          </div>
        </article>

        <article class="card card-half">
          <div class="copy copy-half">
            <FeatureLabel>Interview prep</FeatureLabel>
            <h3 class="display">Walk into every interview briefed</h3>
            <p>
              Happenstance researches the people on your calendar automatically: their background, their work, and who you
              know in common, before every call.
            </p>
          </div>
          <div class="visual visual-half visual-brief" data-motion data-seq="brief" role="img" aria-label="A briefing card for tomorrow’s interview with Omar Faroque, Staff Software Engineer at Meta">
            <div class="visual-bg" aria-hidden="true">
              <Image src={interviewBg} alt="" widths={[572, 1144]} sizes="572px" loading="lazy" />
              <div class="grain" style={`background-image:url(${interviewGrain.src});opacity:.35`}></div>
              <div class="sheen" style={`background-image:${sheen(155, [52.3, 55.3, 56.9, 58, 61.5], [36.2, 40.7, 43.1, 44.8, 50])}, linear-gradient(rgba(255,255,255,.22), rgba(255,255,255,.22))`}></div>
            </div>
            <ThinkingBot tone="pill" class="job-think" />
            <div class="briefing m-hide" data-briefing>
              <p class="brief-head m-hide">
                <img src={calendar} alt="" width="14" height="14" />
                <span>Tomorrow’s interview · briefed from your calendar</span>
                <span class="time">10:00 AM</span>
              </p>
              <div class="brief-person m-hide">
                <Image class="person-photo" src={interviewOmar} alt="" width={40} height={40} densities={[1, 2]} loading="lazy" />
                <span class="person-info">
                  <span class="person-name">Omar Faroque</span>
                  <span class="person-detail">Staff Software Engineer at Meta</span>
                </span>
              </div>
              <p class="brief-note" data-stream>Stanford grad, staff software engineer at Meta.</p>
              <p class="mutual m-hide"><span class="mutual-avatar">IS</span>1 person you know in common</p>
            </div>
            <div class="fade" aria-hidden="true"></div>
          </div>
        </article>
      </div>
    </div>
  </div>

  <script is:inline>
    // Marks the visuals before they paint so their pieces can be revealed in sequence.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
      document.currentScript.parentElement.querySelectorAll('[data-motion]').forEach((el) => (el.dataset.motion = 'pending'));
  </script>
</section>

<script>
  import { createSequence, onFirstView, rise, fadeUp, pop, EASE_IN_OUT, EASE_SETTLE } from '../scripts/motion';

  type Seq = ReturnType<typeof createSequence>;

  const typeQuery = async (root: HTMLElement, s: Seq) => {
    const query = root.querySelector<HTMLElement>('[data-query]')!;
    const text = root.querySelector<HTMLElement>('[data-type]')!;
    s.reveal(query, fadeUp, { duration: 500 });
    query.classList.add('is-typing');
    await s.wait(380);
    await s.typeText(text, text.dataset.type!);
    query.classList.remove('is-typing');
    await s.wait(160);
    // The Happenstance bot thinks just under the query, then the results take its place.
    const bot = root.querySelector<HTMLElement>('[data-thinking]');
    if (bot) bot.style.top = `${query.offsetTop + query.offsetHeight + 18}px`;
    await s.wait(s.think(bot, 0, 850) - 40);
  };

  const sequences: Record<string, (root: HTMLElement, s: Seq) => Promise<void>> = {
    'just-say': async (root, s) => {
      await typeQuery(root, s);
      s.reveal(root.querySelector('[data-results]'), rise, { duration: 650 });
      s.reveal(root.querySelector('.results-head'), fadeUp, { duration: 500, delay: 200 });
      root.querySelectorAll('.job').forEach((job, i) => {
        s.reveal(job, rise, { duration: 600, delay: 320 + i * 120 });
        s.reveal(job.querySelector('.paths-pill'), pop, { duration: 500, delay: 620 + i * 120, easing: EASE_SETTLE });
      });
    },

    referred: async (root, s) => {
      await typeQuery(root, s);
      const [you, ishan, omar] = [...root.querySelectorAll<HTMLElement>('[data-node]')];
      const [l1, l2] = [...root.querySelectorAll<HTMLElement>('[data-link]')];
      const wipe: Keyframe[] = [{ opacity: 1, clipPath: 'inset(0 100% 0 0)' }, { opacity: 1, clipPath: 'inset(0 0 0 0)' }];
      s.reveal(you, pop, { duration: 600, easing: EASE_SETTLE });
      s.reveal(l1, wipe, { duration: 520, delay: 300, easing: EASE_IN_OUT });
      s.reveal(ishan, pop, { duration: 650, delay: 680, easing: EASE_SETTLE });
      s.reveal(l2, wipe, { duration: 520, delay: 1000, easing: EASE_IN_OUT });
      s.reveal(omar, pop, { duration: 600, delay: 1380, easing: EASE_SETTLE });
      await s.wait(1700);
      s.reveal(root.querySelector('[data-draft]'), rise, { duration: 650 });
      s.reveal(root.querySelector('.draft-head'), fadeUp, { duration: 500, delay: 200 });
      const streamed = s.stream(root.querySelector<HTMLElement>('[data-stream]')!, { delay: 380, stagger: 24 });
      s.reveal(root.querySelector('.draft-actions'), fadeUp, { duration: 500, delay: streamed - 150 });
    },

    know: async (root, s) => {
      await typeQuery(root, s);
      root.querySelectorAll('.person').forEach((row, i) => {
        s.reveal(row, rise, { duration: 620, delay: i * 130 });
        s.reveal(row.querySelector('.via'), pop, { duration: 480, delay: 300 + i * 130, easing: EASE_SETTLE });
      });
    },

    brief: async (root, s) => {
      const bot = root.querySelector<HTMLElement>('[data-thinking]');
      if (bot) bot.style.top = '38%';
      await s.wait(s.think(bot, 120, 900) - 40);
      s.reveal(root.querySelector('[data-briefing]'), rise, { duration: 650 });
      s.reveal(root.querySelector('.brief-head'), fadeUp, { duration: 500, delay: 220 });
      s.reveal(root.querySelector('.brief-person'), rise, { duration: 600, delay: 420 });
      const streamed = s.stream(root.querySelector<HTMLElement>('[data-stream]')!, { delay: 760, stagger: 40 });
      s.reveal(root.querySelector('.mutual'), pop, { duration: 520, delay: streamed - 80, easing: EASE_SETTLE });
    },
  };

  document.querySelectorAll<HTMLElement>('.jobs [data-motion="pending"]').forEach((root) => {
    const s = createSequence(root);
    s.reset();
    root.dataset.motion = 'ready';
    onFirstView(root, () => {
      root.dataset.motion = 'playing';
      sequences[root.dataset.seq!](root, s).catch(() => {});
    });
  });
</script>

<style>
  .jobs {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: var(--section-y);
  }

  .bento {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card {
    display: flex;
    overflow: hidden;
    border-radius: var(--r-xl);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    padding: 12px;
    transition: box-shadow 300ms var(--ease), transform 300ms var(--ease);
  }

  .card:hover {
    box-shadow: 0 22px 48px -24px rgba(36, 55, 85, 0.38), 0 2px 4px 0 rgba(36, 55, 85, 0.07);
    transform: translateY(-2px);
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  h3 {
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.33px;
  }

  .copy p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-body);
  }

  /* ---- Visual shell ---- */
  .visual {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r-lg);
    isolation: isolate;
  }

  .visual-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--surface);
  }

  .visual-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease);
  }

  .card:hover .visual-bg img {
    transform: scale(1.025);
  }

  .sheen {
    position: absolute;
    inset: 0;
  }

  .stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .stack-center {
    flex: 1;
    align-items: center;
    justify-content: center;
  }

  .gap-8 {
    gap: 8px;
  }

  .gap-16 {
    gap: 16px;
  }

  .gap-32 {
    gap: 32px;
  }

  .fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 64px;
    background: linear-gradient(rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.94));
    pointer-events: none;
  }

  /* Thinking bot, centred in the visual (top is set from the script). */
  .visual :global(.job-think) {
    position: absolute;
    left: 50%;
    z-index: 2;
    translate: -50% 0;
  }

  /* Query pill with a caret while typing */
  .query {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 37px;
    padding: 10px 18px 10px 14px;
    border-radius: var(--r-md);
    background: var(--surface);
    filter: drop-shadow(0 1px 0.5px rgba(97, 97, 97, 0.1));
    font-size: 14px;
    font-weight: 500;
    color: var(--text-strong);
    white-space: nowrap;
  }

  .caret {
    display: none;
    width: 1.2px;
    height: 15px;
    margin-left: -9px;
    border-radius: 1px;
    background: var(--blue-900);
  }

  .query.is-typing .caret {
    display: inline-block;
  }

  /* Shared person bits */
  .person-photo {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .person-info {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
    white-space: nowrap;
  }

  .person-name {
    font-size: 14px;
    font-weight: 600;
  }

  .person-detail {
    font-size: 12px;
    color: var(--text-faint);
  }

  /* ---- Wide card ---- */
  .card-wide {
    gap: 12px;
    height: 400px;
  }

  .copy-wide {
    flex: 1;
    justify-content: flex-end;
    gap: 14px;
    padding: 32px;
  }

  .visual-wide {
    flex: 0 0 700px;
    border-radius: var(--r-xl);
  }

  .results {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 440px;
    max-width: 100%;
    padding: 10px 8px 8px;
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .results-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 8px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-faint);
  }

  .job {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 48px;
    padding: 10px 12px 10px 10px;
    border-radius: var(--r-md);
    transition: background-color var(--dur) var(--ease);
  }

  .job.top,
  .job:hover {
    background: #f7f7f7;
  }

  .job-title {
    flex: 1;
    min-width: 0;
    font-size: 14px;
    font-weight: 500;
  }

  .paths-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 8px;
    border-radius: var(--r-sm);
    background: var(--bg-subtle);
    font-size: 12px;
    font-weight: 500;
    color: var(--blue-900);
    white-space: nowrap;
  }

  .job.top .paths-pill {
    background: var(--surface);
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.08);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue-400);
    box-shadow: 0 0 0 2px rgba(61, 133, 247, 0.12);
  }

  /* ---- Second row ---- */
  .row {
    display: flex;
    gap: 16px;
    height: 820px;
  }

  .card-tall {
    flex: 1;
    flex-direction: column;
  }

  .copy-top {
    gap: 14px;
    padding: 28px 28px 24px;
  }

  .copy-bottom {
    padding: 24px 28px 20px;
  }

  .visual-tall {
