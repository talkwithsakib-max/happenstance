---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';

import grain from '../assets/footer/grain.png';
import watercolor from '../assets/footer/watercolor.png';
import artMask from '../assets/footer/etching-mask.svg?url';
import wordmark from '../assets/footer/wordmark-flowers.png';
import soc2 from '../assets/security/soc2.png';
import dti from '../assets/security/dti.png';
import linkedin from '../assets/footer/linkedin.svg?url';
import x from '../assets/footer/x.svg?url';
import discord from '../assets/footer/discord.svg?url';

// Content from the previous happenstance.ai footer; layout follows littlebird.ai.
// Footer destinations are not designed yet, so items render without links.
const columns: { title: string; items: (string | [string, string])[] }[] = [
  { title: 'Product', items: ['Chat', ['iPhone app', 'New'], 'Pricing', 'Developers'] },
  { title: 'Use cases', items: ['Founders', 'Investors', 'Sales', 'Recruiting', 'Fundraising', 'Job seekers', 'Communities'] },
  {
    title: 'Connectors',
    items: [['Apple Contacts', 'New'], 'Gmail', 'LinkedIn', 'Google Calendar', 'Google Contacts', 'Outlook', 'X', 'Instagram'],
  },
  { title: 'Resources', items: ['Compare alternatives', 'Buyer’s guides', 'How-tos', 'Get a referral', 'Pitch investors'] },
  { title: 'Apps', items: ['ChatGPT', 'Claude', 'Claude Code', 'Granola', 'OpenClaw'] },
  { title: 'Company', items: ['About', ['Careers', 'We’re hiring'], 'Contact us', 'Security', 'Trust Center'] },
];

const socials = [
  { name: 'X', icon: x },
  { name: 'LinkedIn', icon: linkedin },
  { name: 'Discord', icon: discord },
];
---

<footer class="footer">
  <div class="bg" aria-hidden="true">
    <div class="grain" style={`background-image:url(${grain.src});opacity:.25`}></div>
    <div class="art" style={`--edge-fade:url("${artMask}")`}>
      <Image src={watercolor} alt="" widths={[1792]} sizes="1700px" loading="lazy" />
    </div>
  </div>

  <div class="container inner">
    <div class="top">
      <Logo />
      <ul class="social">
        {
          socials.map((s) => (
            <li>
              <span class="social-icon" role="img" aria-label={s.name}>
                <img src={s.icon} alt="" width="20" height="20" />
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="links" aria-label="Footer">
      {
        columns.map((col) => (
          <div class="column">
            <p class="column-title">{col.title}</p>
            <ul>
              {col.items.map((item) => (
                <li>
                  <span class="link">{Array.isArray(item) ? item[0] : item}</span>
                  {Array.isArray(item) && <span class="pill">{item[1]}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <div class="divider">
      <span class="line"></span>
      <div class="badges">
        <a href="https://www.aicpa.org/soc4so" target="_blank" rel="noopener" aria-label="SOC 2 Compliant">
          <Image src={soc2} alt="" width={40} height={40} densities={[1, 2]} loading="lazy" />
        </a>
        <a href="https://dt-reg.org/registry/services/71" target="_blank" rel="noopener" aria-label="DTI Trust Level 2">
          <Image src={dti} alt="" width={40} height={40} densities={[1, 2]} loading="lazy" />
        </a>
      </div>
      <span class="line"></span>
    </div>

    <div class="bottom">
      <p>© 2026 Happenstance, Inc.</p>
      <ul class="legal">
        <li><span class="link">Privacy</span></li>
        <li><span class="link">Terms</span></li>
      </ul>
    </div>

    <div class="wordmark">
      <Image src={wordmark} alt="happenstance" widths={[1168, 2336]} sizes="(max-width: 1232px) 95vw, 1168px" loading="lazy" />
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--bg-page);
  }

  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* A pale-sky watercolor behind the wordmark; it fades in from transparent above the legal row. */
  .art {
    position: absolute;
    left: 50%;
    bottom: 0;
    /* At least Figma's 1700px, and always wider than the screen, so the painting runs edge to
       edge on wide displays instead of stopping short of one side. */
    width: max(1700px, 100%);
    height: 720px;
    translate: -50% 0;
    mask-image: var(--edge-fade);
    -webkit-mask-image: var(--edge-fade);
    mask-size: 100% 100%;
    -webkit-mask-size: 100% 100%;
  }

  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 72px;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .social {
    display: flex;
    gap: 8px;
  }

  .social-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--r-sm);
    background: rgba(0, 0, 0, 0.05);
    transition: background-color var(--dur) var(--ease);
  }

  .social-icon:hover {
    background: rgba(0, 0, 0, 0.09);
  }

  .links {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 40px 24px;
    padding-top: 16px;
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .column ul {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .column li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .column-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .link {
    font-size: 14px;
    color: var(--text-strong);
    white-space: nowrap;
    cursor: default;
    transition: color var(--dur) var(--ease);
  }

  .link:hover {
    color: var(--text-primary);
  }

  .pill {
    padding: 3px 8px;
    border-radius: var(--r-pill);
    background: var(--gradient-blue);
    box-shadow: var(--shadow-blue-inset);
    font-size: 11px;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
  }

  /* Thin rule with the compliance badges in the middle. */
  .divider {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-top: 24px;
  }

  .line {
    flex: 1;
    height: 1px;
    background: rgba(0, 0, 0, 0.08);
  }

  .badges {
    display: flex;
    gap: 12px;
  }

  .badges img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: transform 300ms var(--ease);
  }

  .badges a:hover img {
    transform: rotate(-8deg);
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 13px;
    color: var(--text-body);
  }

  .legal {
    display: flex;
    gap: 24px;
  }

  .legal .link {
    font-size: 13px;
    color: var(--text-body);
  }

  .legal .link:hover {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .wordmark {
    position: relative;
    height: 209px;
  }

  .wordmark img {
    position: absolute;
    /* Offsets align the export (which includes flower shadows) with the Figma frame. */
    left: calc(50% + 12px);
    top: -7px;
    width: 1168px;
    height: auto;
    max-width: none;
    transform: translateX(-50%);
  }

  @media (max-width: 1279px) {
    .wordmark {
      height: auto;
      aspect-ratio: 1127 / 160;
    }

    .wordmark img {
      top: 0;
      width: 103.6%;
    }
  }

  @media (max-width: 1100px) {
    .links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .inner {
      padding-block: 56px;
    }

    .links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 16px;
    }

    .divider {
      padding-top: 8px;
    }

    .bottom {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
</style>
