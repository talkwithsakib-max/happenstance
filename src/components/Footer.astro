---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';

import grain from '../assets/footer/grain.png';
import watercolor from '../assets/footer/watercolor-lake.png';
import soc2 from '../assets/security/soc2.png';
import dti from '../assets/security/dti.png';
import linkedin from '../assets/footer/linkedin.svg?url';
import x from '../assets/footer/x.svg?url';
import discord from '../assets/footer/discord.svg?url';

// Content from the previous happenstance.ai footer. Layout follows Corgi's footer (via Mobbin): the
// links on a clean surface, then the painting as its own full-strength band underneath.
const columns: { title: string; items: (string | [string, string])[] }[] = [
  { title: 'Product', items: ['Chat', ['iPhone app', 'New'], 'Pricing', 'Developers'] },
  { title: 'Use cases', items: ['Founders', 'Investors', 'Sales', 'Recruiting', 'Fundraising', 'Job seekers', 'Communities'] },
  {
    title: 'Connectors',
    items: [['Apple Contacts', 'New'], 'Gmail', 'LinkedIn', 'Google Calendar', 'Google Contacts', 'Outlook', 'X', 'Instagram'],
  },
  { title: 'Resources', items: ['Compare alternatives', 'Buyer’s guides', 'How-tos', 'Get a referral', 'Pitch investors'] },
  { title: 'Apps', items: ['ChatGPT', 'Claude', 'Claude Code', 'Granola', 'OpenClaw'] },
  { title: 'Company', items: ['About', ['Careers', 'We’re hiring'], 'Contact us', 'Security', 'Trust Center'] },
];

const socials = [
  { name: 'X', icon: x },
  { name: 'LinkedIn', icon: linkedin },
  { name: 'Discord', icon: discord },
];
---

<footer class="footer">
  <div class="container top">
    <div class="brand">
      <Logo />
      <p class="tagline">The AI search engine for the network you actually have.</p>
      <ul class="social">
        {
          socials.map((s) => (
            <li>
              <span class="social-icon" role="img" aria-label={s.name}>
                <img src={s.icon} alt="" width="18" height="18" />
              </span>
            </li>
          ))
        }
      </ul>
      <div class="badges">
        <a href="https://www.aicpa.org/soc4so" target="_blank" rel="noopener" aria-label="SOC 2 Compliant">
          <Image src={soc2} alt="" width={36} height={36} densities={[1, 2]} loading="lazy" />
        </a>
        <a href="https://dt-reg.org/registry/services/71" target="_blank" rel="noopener" aria-label="DTI Trust Level 2">
          <Image src={dti} alt="" width={36} height={36} densities={[1, 2]} loading="lazy" />
        </a>
      </div>
    </div>

    <nav class="links" aria-label="Footer">
      {
        columns.map((col) => (
          <div class="column">
            <p class="column-title">{col.title}</p>
            <ul>
              {col.items.map((item) => (
                <li>
                  <span class="link">{Array.isArray(item) ? item[0] : item}</span>
                  {Array.isArray(item) && <span class="pill">{item[1]}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="container meta">
    <p class="copyright">© 2026 Happenstance, Inc.</p>
    <ul class="legal">
      <li><span class="link">Privacy Policy</span></li>
      <li><span class="link">Terms of Service</span></li>
    </ul>
  </div>

  {/* The painting gets its own band at full strength; only its top edge melts into the surface. */}
  <div class="scene" aria-hidden="true">
    <Image src={watercolor} alt="" widths={[1376, 1792]} sizes="100vw" loading="lazy" />
    <div class="grain" style={`background-image:url(${grain.src});opacity:.4`}></div>
    <span class="watermark">Happenstance</span>
  </div>
</footer>

<style>
  /* Same background as the section above, so the page flows straight into the footer. */
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--bg-page);
  }

  .top {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 40px;
    padding-block: 56px 32px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .tagline {
    max-width: 200px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-body);
  }

  .copyright {
    font-size: 13px;
    color: var(--text-body);
  }

  .links {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 32px 16px;
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .column ul {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .column li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .column-title {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .link {
    font-size: 13px;
    color: var(--text-body);
    white-space: nowrap;
    cursor: default;
    transition: color var(--dur) var(--ease);
  }

  .link:hover {
    color: var(--text-primary);
  }

  .pill {
    padding: 2px 7px;
    border-radius: var(--r-pill);
    background: var(--gradient-blue);
    box-shadow: var(--shadow-blue-inset);
    font-size: 10px;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
  }

  /* Copyright on the left, legal links on the right. */
  .meta {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 8px;
  }

  .legal {
    display: flex;
    gap: 24px;
  }

  .legal .link {
    font-size: 13px;
  }

  .legal .link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .badges {
    display: flex;
    gap: 10px;
  }

  .badges img {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    transition: transform 300ms var(--ease);
  }

  .badges a:hover img {
    transform: rotate(-8deg);
  }

  .social {
    display: flex;
    gap: 6px;
  }

  .social-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--r-sm);
    background: rgba(0, 0, 0, 0.06);
    transition: background-color var(--dur) var(--ease);
  }

  .social-icon:hover {
    background: rgba(0, 0, 0, 0.09);
  }

  .scene {
    position: relative;
    height: clamp(130px, 15vw, 220px);
    margin-top: -24px;
    mask-image: linear-gradient(transparent, #000 26%);
    -webkit-mask-image: linear-gradient(transparent, #000 26%);
  }

  .scene img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
    /* The watercolor is pale; deepen it so it holds its own as a band. */
    filter: saturate(1.6) contrast(1.3) brightness(0.9);
  }

  /* The name, very large, in the sky of the painting and cropped by the bottom edge. */
  .watermark {
    position: absolute;
    left: 50%;
    bottom: -0.13em;
    translate: -50% 0;
    font-size: clamp(48px, 11vw, 160px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.055em;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.55);
    user-select: none;
  }

  @media (max-width: 1100px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .top {
      gap: 28px;
      padding-block: 44px 28px;
    }

    .links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 16px;
    }

    .meta {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
</style>
