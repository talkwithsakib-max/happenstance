---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import StrengthMeter from './StrengthMeter.astro';
import ThinkingBot from './ThinkingBot.astro';

import bgMcp from '../assets/ai/bg-mcp.png';
import bgApi from '../assets/ai/bg-api.png';
import bgCli from '../assets/ai/bg-cli.png';
import grain from '../assets/ai/grain.png';
import sarah from '../assets/ai/sarah-chen.png';
import iconPlug from '../assets/ai/icon-plug.svg?url';
import iconPlugWhite from '../assets/ai/icon-plug-white.svg?url';
import iconBraces from '../assets/ai/icon-braces.svg?url';
import iconBracesWhite from '../assets/ai/icon-braces-white.svg?url';
import iconTerminal from '../assets/ai/icon-terminal.svg?url';
import iconTerminalWhite from '../assets/ai/icon-terminal-white.svg?url';
import chipPlug from '../assets/ai/chip-plug.svg?url';
import chipBraces from '../assets/ai/chip-braces.svg?url';
import chipTerminal from '../assets/ai/chip-terminal.svg?url';
import chatgpt from '../assets/ai/chatgpt.svg?url';
import claude from '../assets/ai/claude.svg?url';
import claudeCode from '../assets/ai/claude-code.svg?url';
import openclaw from '../assets/ai/openclaw.svg?url';
import arrowRight from '../assets/ai/arrow-right.svg?url';
import check from '../assets/ai/check.svg?url';
import dotBlue from '../assets/ai/dot-blue.svg?url';
import toolPlug from '../assets/ai/tool-plug.svg?url';

const tabs = [
  { id: 'mcp', label: 'MCP', icon: iconPlug, iconActive: iconPlugWhite, bg: bgMcp },
  { id: 'api', label: 'API', icon: iconBraces, iconActive: iconBracesWhite, bg: bgApi },
  { id: 'cli', label: 'CLI', icon: iconTerminal, iconActive: iconTerminalWhite, bg: bgCli },
];

const worksWith = [
  { name: 'ChatGPT', icon: chatgpt },
  { name: 'Claude', icon: claude },
  { name: 'Claude Code', icon: claudeCode },
  { name: 'OpenClaw', icon: openclaw },
];
---

<section class="ai container" aria-labelledby="ai-title">
  <SectionHeading id="ai-title" leadWidth={520}>
    <span class="muted">Works with your</span> AI tools
    <Fragment slot="lead">
      Use Happenstance inside ChatGPT and Claude, or build it into anything with the API, MCP server or CLI.
    </Fragment>
  </SectionHeading>

  <div class="stage" data-tabs>
    {
      tabs.map((tab, i) => (
        <Image
          class:list={['stage-bg', { 'is-active': i === 0 }]}
          data-bg={tab.id}
          src={tab.bg}
          alt=""
          widths={[1232, 1376]}
          sizes="(max-width: 1232px) 100vw, 1232px"
          loading="lazy"
        />
      ))
    }
    <div class="grain" style={`background-image:url(${grain.src});opacity:.35`} />

    <div class="tablist" role="tablist" aria-label="Ways to use Happenstance">
      {
        tabs.map((tab, i) => (
          <button
            class:list={['tab', { 'is-active': i === 0 }]}
            id={`tab-${tab.id}`}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${tab.id}`}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="tab-inner">
              <img class="tab-icon" src={tab.icon} alt="" width="18" height="18" />
              <img class="tab-icon-active" src={tab.iconActive} alt="" width="18" height="18" />
              {tab.label}
            </span>
          </button>
        ))
      }
      <span class="stem" aria-hidden="true"></span>
    </div>

    <!-- MCP -->
    <div class="card is-active" id="panel-mcp" role="tabpanel" aria-labelledby="tab-mcp">
      <div class="copy">
        <p class="kicker"><span class="chip-icon"><img src={chipPlug} alt="" width="14" height="14" /></span>MCP server</p>
        <h3 class="display">Ask ChatGPT and <br />Claude <span class="muted">who you know</span></h3>
        <p class="body">
          Add the Happenstance MCP server once, then search your whole network in plain English, right inside your AI
          assistant.
        </p>
        <div class="works">
          <p class="works-label">WORKS WITH</p>
          <ul class="chips">
            {
              worksWith.map((w) => (
                <li class="chip">
                  <img src={w.icon} alt="" width="16" height="16" />
                  {w.name}
                </li>
              ))
            }
          </ul>
        </div>
        <span class="more">Read the docs <img src={arrowRight} alt="" width="16" height="16" /></span>
      </div>

      <div class="visual-wrap"><div class="visual visual-mcp" data-fit="540" data-motion data-seq="mcp" aria-hidden="true">
        <div class="chat m-hide">
          <div class="chat-head">
            <img src={claude} alt="" width="16" height="16" />
            <span class="chat-title">Claude</span>
            <span class="pill"><img src={dotBlue} alt="" width="7" height="7" />Happenstance</span>
          </div>
          <div class="chat-body">
            <p class="bubble m-hide">Who do I know at Bedrock Robotics?</p>
            <ThinkingBot class="mcp-think" />
            <p class="tool m-hide"><img src={toolPlug} alt="" width="12" height="12" /><span class="shimmer">Searched 183,450 connections with Happenstance</span></p>
            <p class="chat-text" data-stream>Your warmest path in:</p>
            <div class="warm m-hide">
              <Image src={sarah} alt="" width={40} height={40} densities={[1, 2]} class="warm-photo" />
              <div class="warm-info">
                <p class="warm-name">Sarah Chen</p>
                <p class="warm-role">Co-Founder &amp; CEO · via Alex Teichman</p>
              </div>
              <StrengthMeter level="strong" />
            </div>
            <p class="more-paths m-hide">+ 2 more warm paths</p>
          </div>
        </div>
        <div class="code code-mcp m-hide">
          <p class="code-head">mcp.json</p>
          <pre><span class="ln m-hide"><span class="k">"happenstance"</span>: {"{"}</span><span class="ln m-hide">  <span class="k">"type"</span>: <span class="s">"http"</span>,</span><span class="ln m-hide">  <span class="k">"url"</span>: <span class="s">".../mcp"</span></span><span class="ln m-hide">{"}"}</span></pre>
        </div>
      </div></div>
    </div>

    <!-- API -->
    <div class="card" id="panel-api" role="tabpanel" aria-labelledby="tab-api" hidden>
      <div class="copy">
        <p class="kicker"><span class="chip-icon"><img src={chipBraces} alt="" width="14" height="14" /></span>REST API</p>
        <h3 class="display">Build <span class="muted">warm intros into <br />your</span> own product</h3>
        <p class="body">
          Query the same relationship graph over a simple API. Pipe ranked results into your CRM, ATS or internal tools
          with one request.
        </p>
        <ul class="bullets">
          <li><img src={check} alt="" width="16" height="16" />Ranked by relationship strength</li>
          <li><img src={check} alt="" width="16" height="16" />Every result includes the warm path</li>
        </ul>
        <span class="more">View API reference <img src={arrowRight} alt="" width="16" height="16" /></span>
      </div>

      <div class="visual-wrap"><div class="visual visual-api" data-fit="540" data-motion data-seq="api" aria-hidden="true">
        <div class="code code-request m-hide">
          <p class="code-head"><span class="method">POST</span><span class="path">/v1/search</span></p>
          <pre><span class="ln m-hide" data-typed-line><span class="k">curl</span> https://api.happenstance.ai/v1/search \</span><span class="ln m-hide" data-typed-line>  -H <span class="s">"Authorization: Bearer $HS_API_KEY"</span> \</span><span class="ln m-hide" data-typed-line>  -d '{"{"}<span class="s">"query"</span>: <span class="s">"seed investors in robotics"</span>{"}"}'</span></pre>
        </div>
        <ThinkingBot tone="pill" class="api-think" />
        <div class="code code-response m-hide">
          <p class="code-head"><span class="ok m-hide">200 OK</span><span class="ms m-hide">142 ms</span></p>
          <pre><span class="ln m-hide">{"{"}</span><span class="ln m-hide">  <span class="k">"results"</span>: [{"{"}</span><span class="ln m-hide">    <span class="k">"name"</span>: <span class="s">"Boris Sofman"</span>,</span><span class="ln m-hide">    <span class="k">"title"</span>: <span class="s">"Co-Founder &amp; CEO"</span>,</span><span class="ln m-hide">    <span class="k">"path"</span>: <span class="s">"via Alex Teichman"</span>,</span><span class="ln m-hide">    <span class="k">"strength"</span>: <span class="n">0.92</span></span><span class="ln m-hide">  {"}"}]</span><span class="ln m-hide">{"}"}</span></pre>
        </div>
      </div></div>
    </div>

    <!-- CLI -->
    <div class="card" id="panel-cli" role="tabpanel" aria-labelledby="tab-cli" hidden>
      <div class="copy">
        <p class="kicker"><span class="chip-icon"><img src={chipTerminal} alt="" width="14" height="14" /></span>Command line</p>
        <h3 class="display">Search <span class="muted">your</span> network <span class="muted">right from the</span> terminal</h3>
        <p class="body">
          Run Happenstance from your shell, or let Claude Code and other agents call it for you. Results land right in
          your workflow.
        </p>
        <ul class="bullets">
          <li><img src={check} alt="" width="16" height="16" />One command to install</li>
          <li><img src={check} alt="" width="16" height="16" />Works with Claude Code and OpenClaw</li>
        </ul>
        <span class="more">Install the CLI <img src={arrowRight} alt="" width="16" height="16" /></span>
      </div>

      <div class="visual-wrap"><div class="visual visual-cli" data-fit="540" data-motion data-seq="cli" aria-hidden="true">
        <div class="code code-terminal m-hide">
          <ThinkingBot tone="dark" class="cli-think" />
          <p class="code-head"><span class="dots"><i></i><i></i><i></i></span><span class="term-title">zsh — happenstance</span></p>
          <pre><span class="ln m-hide" data-typed-line><span class="s">$</span> npm i -g happenstance</span><span class="ln m-hide" data-typed-line><span class="s">$</span> happenstance search <span class="o">"seed investors in robotics"</span></span><span class="ln blank"> </span><span class="ln m-hide"><span class="s">Searched 183,450 connections in 1.2s</span></span><span class="ln blank"> </span><span class="ln m-hide">  1  Boris Sofman   <span class="m">via Alex Teichman</span>   <span class="s">strong</span></span><span class="ln m-hide">  2  Maya Chen      <span class="m">via Priya Desai</span>     <span class="y">good</span></span><span class="ln m-hide">  3  Tom Hughes     <span class="m">via Dana Fox</span>        <span class="m">weak</span></span><span class="ln blank"> </span><span class="ln m-hide"><span class="s">$</span> <span class="cursor">_</span></span></pre>
        </div>
      </div></div>
    </div>
  </div>
  <script is:inline>
    // Marks the visuals before they paint so their pieces can be revealed in sequence.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
      document.currentScript.parentElement.querySelectorAll('[data-motion]').forEach((el) => (el.dataset.motion = 'pending'));
  </script>
</section>

<script>
  import { createSequence, reducedMotion, rise, fadeUp, pop, EASE_SETTLE } from '../scripts/motion';

  type Seq = ReturnType<typeof createSequence>;

  // Once a tab's visual has finished building, it stays up this long before the next tab.
  const READ_MS = 3500;

  // Code lines "type" with a stepped wipe (one step per character); output lines just print.
  const typeLine = (s: Seq, line: Element, delay: number, msPerChar = 22) => {
    const chars = (line.textContent ?? '').length;
    const duration = Math.max(240, chars * msPerChar);
    s.reveal(line, [{ opacity: 1, clipPath: 'inset(0 100% 0 0)' }, { opacity: 1, clipPath: 'inset(0 0 0 0)' }], {
      duration,
      delay,
      easing: `steps(${Math.max(1, chars)}, end)`,
    });
    return delay + duration;
  };
  const printLine = (s: Seq, line: Element, delay: number) =>
    s.reveal(line, [{ opacity: 0, transform: 'translateY(3px)' }, { opacity: 1, transform: 'none' }], { duration: 320, delay });

  const sequences: Record<string, (v: HTMLElement, s: Seq) => void> = {
    mcp: (v, s) => {
      s.reveal(v.querySelector('.chat'), rise, { duration: 600 });
      s.reveal(v.querySelector('.bubble'), [{ opacity: 0, transform: 'translateX(10px) scale(0.97)' }, { opacity: 1, transform: 'none' }], {
        duration: 520,
        delay: 260,
      });
      const tool = v.querySelector<HTMLElement>('.tool')!;
      const bot = v.querySelector<HTMLElement>('.mcp-think');
      if (bot) bot.style.top = `${tool.offsetTop - 4}px`;
      const toolAt = s.think(bot, 760, 1000);
      s.reveal(tool, fadeUp, { duration: 480, delay: toolAt });
      const streamed = s.stream(v.querySelector<HTMLElement>('[data-stream]')!, { delay: toolAt + 450, stagger: 60 });
      s.reveal(v.querySelector('.warm'), rise, { duration: 620, delay: streamed - 120 });
      v.querySelectorAll('.warm .bars i').forEach((bar, j) =>
        s.play(bar, [{ transform: 'scaleY(0)', transformOrigin: '50% 100%' }, { transform: 'scaleY(1)', transformOrigin: '50% 100%' }], {
          duration: 420,
          delay: streamed + 260 + j * 70,
        }),
      );
      s.reveal(v.querySelector('.more-paths'), fadeUp, { duration: 460, delay: streamed + 520 });
      s.reveal(v.querySelector('.code-mcp'), [{ opacity: 0, transform: 'translate(10px, 12px)' }, { opacity: 1, transform: 'none' }], {
        duration: 650,
        delay: streamed + 380,
      });
      v.querySelectorAll('.code-mcp .ln').forEach((ln, i) => typeLine(s, ln, streamed + 700 + i * 260, 16));
    },

    api: (v, s) => {
      s.reveal(v.querySelector('.code-request'), rise, { duration: 600 });
      let t = 380;
      v.querySelectorAll('.code-request .ln').forEach((ln) => (t = typeLine(s, ln, t, 14) + 120));
      t = s.think(v.querySelector('.api-think'), t + 60, 900) - 120;
      s.reveal(v.querySelector('.code-response'), rise, { duration: 620, delay: t + 120 });
      s.reveal(v.querySelector('.ok'), pop, { duration: 460, delay: t + 380, easing: EASE_SETTLE });
      s.reveal(v.querySelector('.ms'), fadeUp, { duration: 400, delay: t + 480 });
      v.querySelectorAll('.code-response .ln').forEach((ln, i) => printLine(s, ln, t + 560 + i * 110));
    },

    cli: (v, s) => {
      s.reveal(v.querySelector('.code-terminal'), rise, { duration: 600 });
      const lines = [...v.querySelectorAll('.code-terminal .ln.m-hide')];
      let t = 420;
      t = typeLine(s, lines[0], t, 38) + 520; // npm i -g happenstance
      t = typeLine(s, lines[1], t, 30) + 200; // happenstance search …
      const bot = v.querySelector<HTMLElement>('.cli-think');
      if (bot) bot.style.top = `${(lines[2] as HTMLElement).offsetTop - 3}px`;
      t = s.think(bot, t, 1000) + 60;
      printLine(s, lines[2], t); // Searched …
      t += 380;
      lines.slice(3, 6).forEach((ln, i) => printLine(s, ln, t + i * 150));
      printLine(s, lines[6], t + 3 * 150 + 260); // prompt
    },
  };

  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls')!)!);
    const backgrounds = [...root.querySelectorAll<HTMLElement>('[data-bg]')];
    const visuals = panels.map((panel) => panel.querySelector<HTMLElement>('[data-motion]')!);
    const animate = !reducedMotion() && visuals.every((v) => v.dataset.motion === 'pending');
    const seqs = visuals.map((v) => createSequence(v));

    let current = 0;
    let started = false;
    let timer: Animation | null = null;
    const holds = new Set<string>(); // reasons auto-rotation is paused

    const playPanel = (i: number) => {
      if (!animate) return;
      seqs[i].reset();
      visuals[i].dataset.motion = 'playing';
      sequences[visuals[i].dataset.seq!](visuals[i], seqs[i]);
    };

    // Auto-advance waits for the active visual to finish animating, then a short reading pause.
    let run = 0;
    const startTimer = async () => {
      if (!animate) return;
      timer?.cancel();
      timer = null;
      const mine = ++run;
      await seqs[current].settled();
      if (mine !== run) return; // a click or another advance started a new run meanwhile
      timer = root.animate([], { duration: READ_MS });
      timer.onfinish = () => select((current + 1) % tabs.length);
      if (holds.size) timer.pause();
    };

    const hold = (reason: string, on: boolean) => {
      if (on) holds.add(reason);
      else holds.delete(reason);
      if (!timer) return;
      if (holds.size) timer.pause();
      else if (timer.playState === 'paused') timer.play();
    };

    // The stem under the tabs glides to the centre of the active tab.
    const tablist = root.querySelector<HTMLElement>('[role="tablist"]')!;
    const placeStem = () => {
      const tab = tabs[current];
      tablist.style.setProperty('--stem-x', `${tab.offsetLeft + tab.offsetWidth / 2}px`);
    };
    new ResizeObserver(placeStem).observe(tablist);

    // Panels share one grid cell: the old one fades out underneath while the new one fades up.
    let leaving: { panel: HTMLElement; anim: Animation } | null = null;
    const swapPanels = (from: number, to: number) => {
      if (leaving) {
        leaving.anim.cancel();
        leaving.panel.classList.remove('is-leaving');
        leaving.panel.hidden = leaving.panel !== panels[to];
        leaving = null;
      }
      panels.forEach((panel, i) => {
        panel.classList.toggle('is-active', i === to);
        if (i !== to && i !== from) panel.hidden = true;
      });
      panels[to].hidden = false;
      if (from === to || !animate) {
        panels[from].hidden = from !== to;
        return;
      }
      const out = panels[from];
      out.classList.add('is-leaving');
      const anim = out.animate([{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateY(-6px)' }], {
        duration: 320,
        easing: 'cubic-bezier(0.4, 0, 1, 1)',
        fill: 'forwards',
      });
      leaving = { panel: out, anim };
      anim.finished.then(() => {
        out.hidden = true;
        out.classList.remove('is-leaving');
        anim.cancel();
        if (leaving?.panel === out) leaving = null;
      }, () => {});
      panels[to].animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], {
        duration: 520,
        delay: 60,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
        fill: 'backwards',
      });
    };

    function select(index: number, focus = false) {
      const previous = current;
      current = index;
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        backgrounds[i]?.classList.toggle('is-active', active);
      });
      swapPanels(previous, index);
      placeStem();
      if (animate && previous !== index) {
        tabs[index].querySelector('.tab-inner')!.animate(
          [{ opacity: 0.4, transform: 'scale(0.96)' }, { opacity: 1, transform: 'none' }],
          { duration: 380, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        );
      }
      if (focus) tabs[index].focus();
      if (animate) {
        started = true;
        playPanel(index);
        startTimer();
      }
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const keys: Record<string, number> = {
          ArrowRight: (i + 1) % tabs.length,
          ArrowLeft: (i - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (event.key in keys) {
          event.preventDefault();
          select(keys[event.key], true);
        }
      });
    });

    if (!animate) return;
    visuals.forEach((v, i) => {
      seqs[i].reset();
      v.dataset.motion = 'ready';
    });

    // Pause rotation while someone is reading or using the tabs, and while off screen.
    root.addEventListener('pointerenter', () => hold('hover', true));
    root.addEventListener('pointerleave', () => hold('hover', false));
    root.addEventListener('focusin', () => hold('focus', true));
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) hold('focus', false);
    });

    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !started && entry.intersectionRatio >= 0.35) {
          started = true;
          playPanel(current);
          startTimer();
        }
        hold('offscreen', !entry.isIntersecting);
      },
      { threshold: [0, 0.35] },
    ).observe(root);
  });
</script>

<style>
  .ai {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: var(--section-y);
  }

  .stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    justify-items: center;
    min-height: 680px;
    padding: 56px 96px;
    overflow: hidden;
    border-radius: var(--r-md);
    background: #e7e1e3;
  }

  .stage-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 800ms var(--ease);
  }

  .stage-bg.is-active {
    opacity: 1;
  }

  /* Tabs */
  .tablist {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .tab {
    position: relative;
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: var(--shadow-tab);
    font-size: 15px;
    font-weight: 500;
    color: var(--text-primary);
    transition: background-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .tab-inner {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px 0 16px;
    border-radius: var(--r-md);
  }

  .tab-icon-active {
    display: none;
  }

  .tab:not(.is-active):hover {
    background: var(--surface);
    transform: translateY(-1px);
  }

  .tab.is-active {
    padding: 2px;
    font-weight: 600;
    color: #fff;
  }

  .tab.is-active .tab-inner {
    gap: 6px;
    height: 40px;
    padding: 0 18px;
    background: var(--gradient-blue);
    box-shadow: var(--shadow-blue-inset);
  }

  .tab.is-active .tab-icon {
    display: none;
  }

  .tab.is-active .tab-icon-active {
    display: block;
  }

  /* Stem joining the active tab to the card */
  /* Stem joining the active tab to the card; one element that glides between tabs. */
  .stem {
    position: absolute;
    top: calc(100% - 1px);
    left: var(--stem-x, 49.5px);
    width: 4px;
    height: 32px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--surface);
    pointer-events: none;
    transition: left 520ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* Card */
  .card {
    position: relative;
    z-index: 1;
    grid-row: 2;
    grid-column: 1;
    display: flex;
    align-items: center;
    gap: 40px;
    width: 100%;
    max-width: 1040px;
    min-height: 488px;
