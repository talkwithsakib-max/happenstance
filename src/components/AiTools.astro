---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import StrengthMeter from './StrengthMeter.astro';

import bgMcp from '../assets/ai/bg-mcp.png';
import bgApi from '../assets/ai/bg-api.png';
import bgCli from '../assets/ai/bg-cli.png';
import grain from '../assets/ai/grain.png';
import sarah from '../assets/ai/sarah-chen.png';
import iconPlug from '../assets/ai/icon-plug.svg?url';
import iconPlugWhite from '../assets/ai/icon-plug-white.svg?url';
import iconBraces from '../assets/ai/icon-braces.svg?url';
import iconBracesWhite from '../assets/ai/icon-braces-white.svg?url';
import iconTerminal from '../assets/ai/icon-terminal.svg?url';
import iconTerminalWhite from '../assets/ai/icon-terminal-white.svg?url';
import chipPlug from '../assets/ai/chip-plug.svg?url';
import chipBraces from '../assets/ai/chip-braces.svg?url';
import chipTerminal from '../assets/ai/chip-terminal.svg?url';
import chatgpt from '../assets/ai/chatgpt.svg?url';
import claude from '../assets/ai/claude.svg?url';
import claudeCode from '../assets/ai/claude-code.svg?url';
import openclaw from '../assets/ai/openclaw.svg?url';
import arrowRight from '../assets/ai/arrow-right.svg?url';
import check from '../assets/ai/check.svg?url';
import dotBlue from '../assets/ai/dot-blue.svg?url';
import toolPlug from '../assets/ai/tool-plug.svg?url';

const tabs = [
  { id: 'mcp', label: 'MCP', icon: iconPlug, iconActive: iconPlugWhite, bg: bgMcp },
  { id: 'api', label: 'API', icon: iconBraces, iconActive: iconBracesWhite, bg: bgApi },
  { id: 'cli', label: 'CLI', icon: iconTerminal, iconActive: iconTerminalWhite, bg: bgCli },
];

const worksWith = [
  { name: 'ChatGPT', icon: chatgpt },
  { name: 'Claude', icon: claude },
  { name: 'Claude Code', icon: claudeCode },
  { name: 'OpenClaw', icon: openclaw },
];
---

<section class="ai container" aria-labelledby="ai-title">
  <SectionHeading id="ai-title" leadWidth={520}>
    <span class="muted">Works with your</span> AI tools
    <Fragment slot="lead">
      Use Happenstance inside ChatGPT and Claude, or build it into anything with the API, MCP server or CLI.
    </Fragment>
  </SectionHeading>

  <div class="stage" data-tabs>
    {
      tabs.map((tab, i) => (
        <Image
          class:list={['stage-bg', { 'is-active': i === 0 }]}
          data-bg={tab.id}
          src={tab.bg}
          alt=""
          widths={[1232, 1376]}
          sizes="(max-width: 1232px) 100vw, 1232px"
          loading="lazy"
        />
      ))
    }
    <div class="grain" style={`background-image:url(${grain.src});opacity:.35`} />

    <div class="tablist" role="tablist" aria-label="Ways to use Happenstance">
      {
        tabs.map((tab, i) => (
          <button
            class:list={['tab', { 'is-active': i === 0 }]}
            id={`tab-${tab.id}`}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${tab.id}`}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="tab-inner">
              <img class="tab-icon" src={tab.icon} alt="" width="18" height="18" />
              <img class="tab-icon-active" src={tab.iconActive} alt="" width="18" height="18" />
              {tab.label}
            </span>
          </button>
        ))
      }
    </div>

    <!-- MCP -->
    <div class="card is-active" id="panel-mcp" role="tabpanel" aria-labelledby="tab-mcp">
      <div class="copy">
        <p class="kicker"><span class="chip-icon"><img src={chipPlug} alt="" width="14" height="14" /></span>MCP server</p>
        <h3 class="display">Ask ChatGPT and <br />Claude <span class="muted">who you know</span></h3>
        <p class="body">
          Add the Happenstance MCP server once, then search your whole network in plain English, right inside your AI
          assistant.
        </p>
        <div class="works">
          <p class="works-label">WORKS WITH</p>
          <ul class="chips">
            {
              worksWith.map((w) => (
                <li class="chip">
                  <img src={w.icon} alt="" width="16" height="16" />
                  {w.name}
                </li>
              ))
            }
          </ul>
        </div>
        <span class="more">Read the docs <img src={arrowRight} alt="" width="16" height="16" /></span>
      </div>

      <div class="visual-wrap"><div class="visual visual-mcp" data-fit="540" aria-hidden="true">
        <div class="chat">
          <div class="chat-head">
            <img src={claude} alt="" width="16" height="16" />
            <span class="chat-title">Claude</span>
            <span class="pill"><img src={dotBlue} alt="" width="7" height="7" />Happenstance</span>
          </div>
          <div class="chat-body">
            <p class="bubble">Who do I know at Bedrock Robotics?</p>
            <p class="tool"><img src={toolPlug} alt="" width="12" height="12" /><span class="shimmer">Searched 183,450 connections with Happenstance</span></p>
            <p class="chat-text">Your warmest path in:</p>
            <div class="warm">
              <Image src={sarah} alt="" width={40} height={40} densities={[1, 2]} class="warm-photo" />
              <div class="warm-info">
                <p class="warm-name">Sarah Chen</p>
                <p class="warm-role">Co-Founder &amp; CEO · via Alex Teichman</p>
              </div>
              <StrengthMeter level="strong" />
            </div>
            <p class="more-paths">+ 2 more warm paths</p>
          </div>
        </div>
        <div class="code code-mcp">
          <p class="code-head">mcp.json</p>
          <pre><span class="k">"happenstance"</span>: {"{"}
  <span class="k">"type"</span>: <span class="s">"http"</span>,
  <span class="k">"url"</span>: <span class="s">".../mcp"</span>
{"}"}</pre>
        </div>
      </div></div>
    </div>

    <!-- API -->
    <div class="card" id="panel-api" role="tabpanel" aria-labelledby="tab-api" hidden>
      <div class="copy">
        <p class="kicker"><span class="chip-icon"><img src={chipBraces} alt="" width="14" height="14" /></span>REST API</p>
        <h3 class="display">Build <span class="muted">warm intros into <br />your</span> own product</h3>
        <p class="body">
          Query the same relationship graph over a simple API. Pipe ranked results into your CRM, ATS or internal tools
          with one request.
        </p>
        <ul class="bullets">
          <li><img src={check} alt="" width="16" height="16" />Ranked by relationship strength</li>
          <li><img src={check} alt="" width="16" height="16" />Every result includes the warm path</li>
        </ul>
        <span class="more">View API reference <img src={arrowRight} alt="" width="16" height="16" /></span>
      </div>

      <div class="visual-wrap"><div class="visual visual-api" data-fit="540" aria-hidden="true">
        <div class="code code-request">
          <p class="code-head"><span class="method">POST</span><span class="path">/v1/search</span></p>
          <pre><span class="k">curl</span> https://api.happenstance.ai/v1/search \
  -H <span class="s">"Authorization: Bearer $HS_API_KEY"</span> \
  -d '{"{"}<span class="s">"query"</span>: <span class="s">"seed investors in robotics"</span>{"}"}'</pre>
        </div>
        <div class="code code-response">
          <p class="code-head"><span class="ok">200 OK</span><span class="ms">142 ms</span></p>
          <pre>{"{"}
  <span class="k">"results"</span>: [{"{"}
    <span class="k">"name"</span>: <span class="s">"Boris Sofman"</span>,
    <span class="k">"title"</span>: <span class="s">"Co-Founder &amp; CEO"</span>,
    <span class="k">"path"</span>: <span class="s">"via Alex Teichman"</span>,
    <span class="k">"strength"</span>: <span class="n">0.92</span>
  {"}"}]
{"}"}</pre>
        </div>
      </div></div>
    </div>

    <!-- CLI -->
    <div class="card" id="panel-cli" role="tabpanel" aria-labelledby="tab-cli" hidden>
      <div class="copy">
        <p class="kicker"><span class="chip-icon"><img src={chipTerminal} alt="" width="14" height="14" /></span>Command line</p>
        <h3 class="display">Search <span class="muted">your</span> network <span class="muted">right from the</span> terminal</h3>
        <p class="body">
          Run Happenstance from your shell, or let Claude Code and other agents call it for you. Results land right in
          your workflow.
        </p>
        <ul class="bullets">
          <li><img src={check} alt="" width="16" height="16" />One command to install</li>
          <li><img src={check} alt="" width="16" height="16" />Works with Claude Code and OpenClaw</li>
        </ul>
        <span class="more">Install the CLI <img src={arrowRight} alt="" width="16" height="16" /></span>
      </div>

      <div class="visual-wrap"><div class="visual visual-cli" data-fit="540" aria-hidden="true">
        <div class="code code-terminal">
          <p class="code-head"><span class="dots"><i></i><i></i><i></i></span><span class="term-title">zsh — happenstance</span></p>
          <pre><span class="s">$</span> npm i -g happenstance
<span class="s">$</span> happenstance search <span class="o">"seed investors in robotics"</span>

<span class="s">Searched 183,450 connections in 1.2s</span>

  1  Boris Sofman   <span class="m">via Alex Teichman</span>   <span class="s">strong</span>
  2  Maya Chen      <span class="m">via Priya Desai</span>     <span class="y">good</span>
  3  Tom Hughes     <span class="m">via Dana Fox</span>        <span class="m">weak</span>

<span class="s">$</span> <span class="cursor">_</span></pre>
        </div>
      </div></div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls')!)!);
    const backgrounds = [...root.querySelectorAll<HTMLElement>('[data-bg]')];

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[i].hidden = !active;
        panels[i].classList.toggle('is-active', active);
        backgrounds[i]?.classList.toggle('is-active', active);
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const keys: Record<string, number> = {
          ArrowRight: (i + 1) % tabs.length,
          ArrowLeft: (i - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (event.key in keys) {
          event.preventDefault();
          select(keys[event.key], true);
        }
      });
    });
  });
</script>

<style>
  .ai {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: var(--section-y);
  }

  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 680px;
    padding: 56px 96px;
    overflow: hidden;
    border-radius: var(--r-md);
    background: #e7e1e3;
  }

  .stage-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 600ms var(--ease);
  }

  .stage-bg.is-active {
    opacity: 1;
  }

  /* Tabs */
  .tablist {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .tab {
    position: relative;
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: var(--shadow-tab);
    font-size: 15px;
    font-weight: 500;
    color: var(--text-primary);
    transition: background-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .tab-inner {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px 0 16px;
    border-radius: var(--r-md);
  }

  .tab-icon-active {
    display: none;
  }

  .tab:not(.is-active):hover {
    background: var(--surface);
    transform: translateY(-1px);
  }

  .tab.is-active {
    padding: 2px;
    font-weight: 600;
    color: #fff;
  }

  .tab.is-active .tab-inner {
    gap: 6px;
    height: 40px;
    padding: 0 18px;
    background: var(--gradient-blue);
    box-shadow: var(--shadow-blue-inset);
  }

  .tab.is-active .tab-icon {
    display: none;
  }

  .tab.is-active .tab-icon-active {
    display: block;
  }

  /* Stem joining the active tab to the card */
  .tab.is-active::after {
    content: '';
    position: absolute;
    top: calc(100% - 1px);
    left: calc(50% - 2px);
    width: 4px;
    height: 32px;
    border-radius: 2px;
    background: var(--surface);
  }

  /* Card */
  .card {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 40px;
    width: 100%;
    max-width: 1040px;
    min-height: 488px;
    margin-top: 24px;
    padding: 40px;
    border-radius: var(--r-xl);
    background: var(--surface);
    box-shadow: var(--shadow-float);
  }

  .card[hidden] {
    display: none;
  }

  .card.is-active .copy > *,
  .card.is-active .visual > * {
    animation: enter 450ms var(--ease) both;
  }

  .card.is-active .visual > :nth-child(2) {
    animation-delay: 80ms;
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .copy {
    display: flex;
    flex: 0 0 380px;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
  }

  .chip-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: var(--r-xs);
    background: var(--blue-400);
  }

  h3 {
    font-size: 34px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.85px;
  }

  .body {
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-body);
  }

  .works {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .works-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.66px;
    color: var(--text-faint);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px 6px 8px;
    border-radius: var(--r-pill);
    background: var(--bg-subtle);
    font-size: 13px;
    font-weight: 500;
  }

  .bullets {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .bullets li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-body);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-bottom: 4px;
    font-size: 15px;
    font-weight: 500;
  }

  .more img {
    transition: transform var(--dur) var(--ease);
  }

  .more:hover img {
    transform: translateX(3px);
  }

  /* Visuals */
  .visual-wrap {
    flex: 0 0 540px;
  }

  .visual {
    position: relative;
    width: 540px;
    height: 408px;
    zoom: var(--fit, 1);
    overflow: hidden;
    border-radius: var(--r-xl);
  }

  .visual::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: soft-light;
    background: repeating-linear-gradient(
      121.68deg,
      rgba(255, 255, 255, 0) 0,
      rgba(255, 255, 255, 0.35) 13.8px,
      rgba(255, 255, 255, 0) 32px,
      rgba(255, 255, 255, 0) 53.6px
    );
  }

  .visual-mcp {
    background:
      radial-gradient(297px 184px at 0 114px, #e2b9e7, transparent),
      radial-gradient(216px 122px at 43px 0, #f0c4d8, transparent),
      radial-gradient(270px 155px at 540px 171px, #fdbec5, transparent),
      radial-gradient(351px 163px at 0 408px, #fecfd1, transparent),
      radial-gradient(324px 143px at 297px 16px, #fff3ef, transparent),
      linear-gradient(180deg, #fff0ee, #fee6e6);
  }

  .visual-api {
    background:
      radial-gradient(243px 163px at 0 408px, #4f93e5, transparent),
      radial-gradient(324px 224px at 0 388px, #8fd3ec, transparent),
      radial-gradient(243px 163px at 0 143px, #b9e4ed, transparent),
      radial-gradient(243px 143px at 540px 143px, #b0e1e5, transparent),
      radial-gradient(324px 122px at 216px 0, #dceef3, transparent),
      linear-gradient(180deg, #d6ecf0, #c6e7ee);
  }

  .visual-cli {
    display: grid;
    place-items: center;
    background:
      radial-gradient(243px 143px at 0 335px, #a3d3d1, transparent),
      radial-gradient(216px 122px at 0 73px, #bbe3cb, transparent),
      radial-gradient(297px 122px at 81px 196px, #eef6f5, transparent),
      radial-gradient(216px 143px at 540px 20px, #ecf7ee, transparent),
      radial-gradient(324px 143px at 270px 0, #d3efdc, transparent),
      linear-gradient(180deg, #d5f0de, #d0ece6 55%, #c3e3e2);
  }

  /* MCP chat mock */
  .chat {
    position: absolute;
    top: 28px;
    left: 28px;
    z-index: 1;
    width: 404px;
    overflow: hidden;
    border-radius: var(--r-xl);
    background: var(--surface);
    box-shadow: var(--shadow-float);
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
  }

  .chat-title {
    flex: 1;
    font-size: 13px;
    font-weight: 600;
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: var(--r-pill);
    background: var(--bg-soft);
    font-size: 11px;
    font-weight: 500;
  }

  .chat-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
  }

  .bubble {
    align-self: flex-end;
    padding: 8px 12px;
    border-radius: var(--r-md);
    background: var(--bg-soft);
    font-size: 13px;
  }

  .tool {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
  }

  .shimmer {
    background: linear-gradient(90deg, #757575 0%, #757575 35%, #070707 50%, #757575 65%, #757575 100%);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 2.6s linear infinite;
  }

  @keyframes shimmer {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0 0;
    }
  }

  .chat-text {
    font-size: 13px;
  }

  .warm {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 76px;
    padding: 12px 14px 12px 12px;
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: 0 14px 36px 0 rgba(61, 133, 247, 0.32), 0 2px 4px 0 rgba(36, 55, 85, 0.07);
  }

  .warm-photo {
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }

  .warm-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    white-space: nowrap;
  }

  .warm-name {
    font-size: 14px;
    font-weight: 600;
  }

  .warm-role {
    font-size: 12px;
    color: var(--text-body);
  }

  .more-paths {
    font-size: 12px;
    font-weight: 500;
    color: var(--blue-700);
  }

  /* Code windows */
  .code {
    position: absolute;
    z-index: 2;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--code-bg);
    box-shadow: var(--shadow-float);
    color: var(--code-text);
  }

  .code-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    font-size: 11px;
    color: var(--code-muted);
  }

  pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
    white-space: pre;
  }

  .k {
    color: var(--code-key);
  }

  .s {
    color: var(--code-string);
  }

  .o {
    color: #fdba74;
  }

  .y {
    color: #fde047;
  }

  .m {
    color: var(--code-muted);
  }

  .code-mcp {
    top: 227px;
    left: 312px;
    width: 212px;
    background:
      radial-gradient(170px 106px at 50% 13px, rgba(250, 250, 250, 0.15), transparent),
      var(--code-bg);
  }

  .code-mcp pre {
    padding: 12px 14px;
    font-family: var(--font-sans);
    font-size: 11px;
  }

  .code-request {
    top: 28px;
    left: 28px;
    width: 484px;
  }

  .code-request pre,
  .code-response pre {
    padding: 14px 16px;
  }

  .method {
    padding: 3px 8px;
    border-radius: var(--r-pill);
    background: #166534;
    font-family: var(--font-mono);
    font-weight: 500;
    color: #bbf7d0;
  }

  .path {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--code-text);
  }

  .code-response {
    top: 146px;
    left: 88px;
    width: 424px;
    background: var(--surface);
    color: var(--text-primary);
  }

  .code-response .k {
    color: #2563eb;
  }

  .code-response .s {
    color: #16803d;
  }

  .n {
    color: var(--amber-700);
  }

  .ok {
    padding: 3px 8px;
    border-radius: var(--r-pill);
    background: #e7f6ec;
    font-weight: 500;
    color: #16803d;
  }

  .ms {
